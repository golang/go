+// surrogates and malformed UTF-8 decode as U+FFFD rather than rejecting the
+// string token.
+func TestQuotedTextPermissiveUnquoteMatchesEncodingJSON(t *testing.T) {
+	for _, in := range []string{`"\ud800"`, `"\ud83d\ude00"`, "\"\xff\"", `"x\ud800y"`} {
