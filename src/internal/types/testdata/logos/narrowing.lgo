package p

// M3-S4 nil narrowing (SPEC Sec 2.2, T-202): `if x != nil` narrows an
// option-typed local or parameter to its element in the guarded block,
// through `&&` chains, and after an early exit on `x == nil` (return,
// panic, break, or continue). Assignment ends narrowing. Narrowing never
// applies to fields, to variables whose address is taken, or to
// variables assigned in a closure or a loop body.

type User struct {
	Name string
	Age  int
}

func (u User) Greet() string { return u.Name }

type Holder struct {
	P *User?
}

// In-block narrowing: field, deref, method, and stores into non-nil
// slots are all legal on the narrowed value.
func narrowBlock(up *User?) {
	if up != nil {
		_ = up.Name
		_ = *up
		_ = up.Greet()
		_ = up.Age + 1
		var w *User = up
		_ = w
		var q *User? = up
		_ = q
	}
}

// `?.` and `??` still accept a narrowed receiver through its declared
// option type.
func narrowChain(up *User?) {
	if up != nil {
		_ = up?.Name
		_ = up ?? &User{Name: "d"}
	}
}

// Early exit on `== nil` narrows for the rest of the block.
func earlyReturn(up *User?) {
	if up == nil {
		return
	}
	_ = up.Name
}

func earlyPanic(up *User?) {
	if up == nil {
		panic("nil")
	}
	_ = up.Name
}

func earlyBreak(up *User?, n int) {
	for i := 0; i < n; i++ {
		if up == nil {
			break
		}
		_ = up.Name
	}
}

func earlyContinue(up *User?, n int) {
	for i := 0; i < n; i++ {
		if up == nil {
			continue
		}
		_ = up.Name
	}
}

// `x != nil && rest` narrows x for rest and for the guarded block.
func andChain(up *User?) {
	if up != nil && up.Age > 0 {
		_ = up.Name
	}
}

// Assignment ends narrowing until the next re-narrow.
func killAssign(up *User?, other *User?) {
	if up != nil {
		_ = up.Name
		up = other
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
		if up != nil {
			_ = up.Name
		}
	}
}

// Taking the address disables narrowing for the whole function.
func addrTaken(up *User?) {
	p := &up
	_ = p
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

// Assigning in a closure disables narrowing for the whole function.
func closureAssign(up *User?) {
	f := func() {
		up = nil
	}
	_ = f
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

// Assigning in a loop body disables narrowing for the whole function.
func loopAssign(up *User?, n int) {
	for i := 0; i < n; i++ {
		up = nil
	}
	if up != nil {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

// A nil test on a field never narrows the field.
func fieldNoNarrow(h Holder) {
	if h.P != nil {
		_ = h.P.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
}

// Copying the field to a local narrows normally.
func fieldCopy(h Holder) {
	loc := h.P
	if loc != nil {
		_ = loc.Name
	}
}

// The else branch of `!= nil` is not narrowed, and neither is the code
// after the if.
func elseBranch(up *User?) {
	if up != nil {
		_ = up.Name
	} else {
		_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	}
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
}

// The else of `== nil` proves `!= nil`: narrowing holds inside the else
// and after the if, since the only fall-through path has up != nil.
func elseFall(up *User?) {
	if up == nil {
		return
	} else {
		_ = up.Name
	}
	_ = up.Name
}

// An assignment in the else branch voids the proof after the if.
func elseFallKill(up *User?, other *User?) {
	if up == nil {
		return
	} else {
		up = other
	}
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
}

// Narrowing survives nested blocks; shadowing inside does not kill the
// outer narrowing (#14 keeps standard block scoping).
func outerScope(up *User?) {
	if up == nil {
		return
	}
	{
		_ = up.Name
		loc := up
		_ = loc.Name
		up2 := 1
		_ = up2
	}
	_ = up.Name
}

// Plain selections, derefs, and stores without a guard still fail.
func noGuard(up *User?) {
	_ = up.Name /* ERROR "[correctness::nil_deref_unproven] cannot access field Name of *User? without proving != nil" */
	_ = *up /* ERROR "cannot indirect" */
	var v *User = up /* ERROR "as *User value in" */
	_ = v
	_ = up
}
