package p

// M4-S1 property interfaces (SPEC Sec 2.3, T-203.2): `const F T` is a
// read-only property, `F T` a read-write one, mixed with methods and
// embedded interfaces. A struct satisfies a property interface only
// through an explicit `: I` declaration, sourced per property from an
// exported field or a method `F() T` (plus `SetF(T)` for read-write).

type Creature interface {
	const Name string
	HP int
	Start() error
}

// Field sources satisfy every property; the value-receiver Start keeps
// both Monster and *Monster in the method set.

type Monster struct : Creature {
	Name string
	HP   int
}

func (m Monster) Start() error { return nil }

var _ Creature = &Monster{}

var monsterVal = Monster{}

var _ Creature = monsterVal /* ERROR "correctness::property_needs_pointer" */

// A read-only interface accepts a value: no setter means no pointer
// requirement.

type Being interface {
	const Name string
	Greet() string
}

type Peasant struct : Being {
	Name string
}

func (p Peasant) Greet() string { return "hi" }

var _ Being = Peasant{}

// A method with no backing field sources a read-only property.

type Named interface {
	const Name string
}

type Ghost struct : Named {
}

func (g Ghost) Name() string { return "boo" }

var _ Named = Ghost{}

// Embedded struct fields satisfy by Go selector depth.

type Base struct {
	HP int
}

type Child struct : Creature {
	Base
	Name string
}

func (c Child) Start() error { return nil }

var _ Creature = &Child{}

// An embedded property interface contributes its properties; the
// read-only Name and the read-write HP merge with the local Nick.

type Pet interface {
	Creature
	const Nick string
	Speak() string
}

type Pup struct : Pet {
	Name string
	HP   int
	Nick string
}

func (p Pup) Start() error { return nil }
func (p Pup) Speak() string { return "woof" }

var _ Pet = &Pup{}

// Read-only and read-write declarations of one name in one interface
// merge into read-write (#131): no error here, but a value still needs
// a pointer.

type Merged interface {
	const Val int
	Val int
}

type HasVal struct : Merged {
	Val int
}

var _ Merged = &HasVal{}

var hasVal = HasVal{}

var _ Merged = hasVal /* ERROR "correctness::property_needs_pointer" */

// The same name with different types in one interface conflicts.

type BadIface interface {
	const ID int64
	ID /* ERROR "correctness::property_conflict" */ string
}

// Conflicting property types across listed interfaces fail.

type HasID64 interface {
	ID int64
}

type HasIDStr interface {
	ID string
}

type Mixed struct : HasID64, HasIDStr /* ERROR "correctness::property_conflict" */ {
	ID int64
}

// The right fields without the declaration fail: the fix is to add
// `: Creature`.

type Drifter struct {
	Name string
	HP   int
}

func (d *Drifter) Start() error { return nil }

var drifter = &Drifter{}

var _ Creature = drifter /* ERROR "correctness::property_requires_conformance" */

// A declaration without a source for HP fails.

type Wisp struct : Creature /* ERROR "correctness::property_unsatisfied" */ {
	Name string
}

// An equal-depth embedded match is ambiguous, not a source.

type Left struct {
	HP int
}

type Right struct {
	HP int
}

type Ambig struct : Creature /* ERROR "ambiguous selector" */ {
	Left
	Right
	Name string
}

// Taking the address of a property fails.

func takeAddr(c Creature) {
	_ = &c.HP /* ERROR "correctness::property_address" */
}

// Property reads through the interface check with the property type.

func readName(c Creature) string {
	return c.Name
}

func readHP(c Creature) int {
	return c.HP
}

// A read-write property is assignable through the interface.

func writeHP(c Creature, v int) {
	c.HP = v
}

// A declared Logos_ method hits the reserved identifier rule.

type BadName struct {
	X int
}

func (b BadName) Logos_GetX /* ERROR "correctness::reserved_identifier" */ () int { return 0 }

// A declared Logos_GetHP method on a conforming type still hits the
// reserved identifier rule: it is never an accessor source.

type Sneaky struct : Creature {
	Name string
	HP   int
}

func (s Sneaky) Start() error { return nil }

func (s Sneaky) Logos_GetHP /* ERROR "correctness::reserved_identifier" */ () int { return 0 }
