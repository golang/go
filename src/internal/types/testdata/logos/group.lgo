package p

import "context"

// Shared helpers for the group checks below.

func work(ctx context.Context) error { return nil }

func noval(ctx context.Context) {}

func groupfn(x int) {}

// A `?` in a child block returns to the group: no error.

func groupQ(ctx context.Context) error {
	go group (ctx) {
		go {
			work(ctx)?
		}
	}
	return nil
}

// A `go f(args)` child with an error-last result sends it to the group:
// no error.

func groupCall(ctx context.Context) error {
	go group (ctx) {
		go work(ctx)
		go noval(ctx)
	}
	return nil
}

// A `go func() {}()` child is a child: no error.

func groupLit(ctx context.Context) error {
	go group (ctx) {
		go func() {
		}()
	}
	return nil
}

// A limit bounds the group: no error.

func groupLimit(ctx context.Context) error {
	go group (ctx, limit = 4) {
		go work(ctx)
	}
	return nil
}

// A nested group forms a child of the outer group: no error.

func groupNest(ctx context.Context) error {
	go group (ctx) {
		go group (ctx) {
			go work(ctx)
		}
	}
	return nil
}

// A `return` in a child block fails.

func groupRet(ctx context.Context) error {
	go group (ctx) {
		go {
			return /* ERROR "return_in_group_child" */ nil
		}
	}
	return nil
}

// A bare `return` in a child block fails too.

func groupRetBare(ctx context.Context) error {
	go group (ctx) {
		go {
			return /* ERROR "return_in_group_child" */
		}
	}
	return nil
}

// A child block outside a group body fails.

func strayChild() error {
	go /* ERROR "child_outside_group" */ {
	}
	return nil
}

// A `go` statement outside any group body fails.

func strayGo(ctx context.Context) error {
	go /* ERROR "unsupervised_goroutine" */ work(ctx)
	return nil
}

// A `go group(x)` without a block stays an ordinary go call, so the
// unsupervised rule still applies outside a group body.

func callGroup() error {
	go /* ERROR "unsupervised_goroutine" */ groupfn(1)
	return nil
}

// A `go` on a non-call fails, inside a group body too.

func groupNoCall(ctx context.Context) error {
	go group (ctx) {
		go work /* ERROR "expression in go must be function call" */
	}
	return nil
}

// A `go group` in a function without an error result fails.

func groupNoErr(ctx context.Context) {
	go group (ctx /* ERROR "group_needs_error_result" */) {
		go {
		}
	}
}

// A non-context group context fails.

func groupBadCtx(n int) error {
	go group (n /* ERROR "must be context.Context" */) {
	}
	return nil
}

// A non-integer limit fails.

func groupBadLimit(ctx context.Context) error {
	go group (ctx, limit = "x" /* ERROR "limit must be an integer" */) {
	}
	return nil
}

// A deferred call outside a group body is unaffected.

func deferOK(ctx context.Context) error {
	defer work(ctx)
	return nil
}
