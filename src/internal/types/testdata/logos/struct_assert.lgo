package p

// M2 inline struct assertions (SPEC Sec 2.3, T-203.3): `type S struct :
// I, J { ... }` asserts *S implements each listed interface. A missing
// method fails with [correctness::assertion_failed]; satisfied, promoted,
// and value-receiver methods pass.

type I interface {
	M()
}

type J interface {
	N()
}

// FAIL: *SNoM has no M.
type SNoM struct : I /* ERROR "correctness::assertion_failed" */ {
	X int
}

// PASS: a value-receiver M is in *SVal's method set.
type SVal struct : I {
	X int
}

func (s SVal) M() {}

// FAIL: I is satisfied but J is missing N.
type SMulti struct : I, J /* ERROR "correctness::assertion_failed" */ {
	X int
}

func (s SMulti) M() {}

// PASS: M is promoted from the embedded S2.
type S2 struct {
	Y int
}

func (s S2) M() {}

type SEmbed struct : I {
	S2
}
