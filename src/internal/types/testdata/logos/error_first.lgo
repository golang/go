package p

import "bytes"
import "strconv"

// M3-S4 error-first guard (SPEC Sec 2.2, T-202): for a callee declared
// in .lgo, reading a result before the `err == nil` proof fails with
// [correctness::result_before_error_check]. The proof is the fall-through
// of `if err != nil { exit }` or the inside of `if err == nil {}`.
// Callees from other packages keep their own contracts (#23, #156).

func fetch() (int, error) {
	return 1, nil
}

func useInt(v int) {
}

// Reading n before any check fails.
func beforeCheck() {
	n, err := fetch()
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
	if err != nil {
		return
	}
	useInt(n)
}

// The fall-through of an exiting `err != nil` check discharges the guard.
func afterCheck() {
	n, err := fetch()
	if err != nil {
		return
	}
	useInt(n)
	_ = n
}

// Inside `err == nil` the guard is discharged; after the if it applies
// again on the fall-through path.
func insideNil() {
	n, err := fetch()
	if err == nil {
		useInt(n)
	}
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
}

// Reassigning the result voids the guard: the fresh value is unchecked.
func reassignResult() {
	n, err := fetch()
	n = 42
	useInt(n)
	_ = err
}

// Plain `=` tuple bindings arm the guard the same way.
func plainAssign() {
	var n int
	var err error
	n, err = fetch()
	useInt(n /* ERROR "[correctness::result_before_error_check]" */)
	if err != nil {
		return
	}
	useInt(n)
	_ = err
}

// A package-qualified call into another package keeps its own contract:
// using n first stays legal.
func goPackageCall() {
	n, err := strconv.Atoi("42")
	useInt(n)
	if err != nil {
		return
	}
	useInt(n)
}

// A method declared outside .lgo keeps its own contract as well.
func goMethodCall() {
	r := bytes.NewReader([]byte("hi"))
	buf := make([]byte, 4)
	n, err := r.Read(buf)
	useInt(n)
	if err != nil {
		return
	}
	useInt(n)
	_ = buf
}
