-- A.Play --
package main

import (
	"fmt"
)

func square(i int) int {
	// Multiply i by itself.
	return i * i
}

type T struct {
	// X is a field.
	X int // trailing
}

var a = 1

var c, e = func() int {
	// Return one.
	return 1
}(), 3

func main() {
	fmt.Println(square(a), T{}, c, e)
}
