package main

/*
#include <stdint.h>

//logos:cgo_fastcall caddf
//logos:cgo_fastcall cbusyf
int caddf(int a, int b) { return a + b; }
static unsigned long long do_spin(unsigned long long iters) {
	unsigned long long x = 0;
	for (unsigned long long i = 0; i < iters; i++) {
		x += i * 6364136223846793005ULL + 1442695040888963407ULL;
	}
	return x;
