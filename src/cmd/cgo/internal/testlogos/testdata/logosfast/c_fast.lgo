unsigned long long cbusyf(unsigned long long iters) { return do_spin(iters); }
*/
import "C"

import (
	"fmt"
	"os"
	"runtime/pprof"
	"strconv"
)

func main() {
	if len(os.Args) > 1 && os.Args[1] == "busy" {
		f, err := os.Create(os.Args[2])
		if err != nil {
			fmt.Println("profile:", err)
			os.Exit(1)
		}
		n, err := strconv.Atoi(os.Args[3])
		if err != nil {
			fmt.Println("iters:", err)
			os.Exit(1)
		}
		if err := pprof.StartCPUProfile(f); err != nil {
			fmt.Println("prof:", err)
			os.Exit(1)
		}
		C.cbusyf(20000000)
		x := C.cbusyf(C.ulonglong(n))
		pprof.StopCPUProfile()
		if err := f.Close(); err != nil {
			fmt.Println("profile:", err)
			os.Exit(1)
		}
		fmt.Println(uint64(x))
		return
	}
	fmt.Println(int(C.caddf(40, 2)))
}
