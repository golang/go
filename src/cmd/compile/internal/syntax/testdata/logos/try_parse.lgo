// M1-S2 parser attacks: `?` postfix and errdefer statements.
// Every form without an ERROR comment must parse cleanly in LogosMode;
// each ERROR comment pins the exact syntax error text.

package p

func f() (int, error) { return 0, nil }
func g() error        { return nil }

type Tx struct{}

func (Tx) Rollback() error { return nil }

func okAssign() (int, error) {
	x := f()?
	return x, nil
}

func okReassign() (int, error) {
	x := 0
	x = f()?
	return x, nil
}

func okExpr() error {
	g()?
	return nil
}

func okDefer() error {
	defer g()?
	return nil
}

func okErrdefer() error {
	errdefer g()
	return nil
}

func okErrdeferMethod(tx Tx) error {
	errdefer tx.Rollback()?
	return nil
}

func okErrdeferFuncLit() error {
	errdefer func() { g() }()
	return nil
}

func keepDefine() {
	errdefer := 1
	_ = errdefer
}

func keepAssign() {
	errdefer := 1
	errdefer = 2
	_ = errdefer
}

func keepCall(errdefer func(int)) {
	x := 1
	errdefer(x)
}

func keepSelect(errdefer Tx) {
	errdefer.f()
}

func badErrdeferOperand() error {
	errdefer 1 // ERROR syntax error: errdefer requires a function call
	return nil
}

func okGoTry() error {
	go g()?
	return nil
}

func badErrdeferStruct() error {
	errdefer struct{ f func() }{g}.f() // ERROR syntax error: errdefer requires a function call
	return nil
}

func badErrdeferMap() error {
	errdefer map[int]func(){0: g}[0]() // ERROR syntax error: errdefer requires a function call
	return nil
}

func badErrdeferIface(v interface{ M() }) error {
	errdefer interface{ M() }(v).M() // ERROR syntax error: errdefer requires a function call
	return nil
}

func badDeferParenTry() error {
	defer (g())? // ERROR expression in defer must not be parenthesized
	return nil
}

func badGoParenTry() error {
	go (g())? // ERROR expression in go must not be parenthesized
	return nil
}

func keepLabel() {
errdefer:
	for {
		break errdefer
	}
}

func keepInc(errdefer int) {
	errdefer++
}

func keepDec(errdefer int) {
	errdefer--
}

func keepSend(errdefer chan int, v int) {
	errdefer <- v
}

func keepIndex(errdefer []int) {
	errdefer[0] = 1
}

func keepMulti() {
	errdefer, x := 1, 2
	_, _ = errdefer, x
}

func keepBare(errdefer int) {
	errdefer
	_ = errdefer
}

func keepCallLit(errdefer func(func())) {
	errdefer(func(){})
}

func keepParenCall() {
	errdefer (f())
}

func keepDot(errdefer Tx) {
	errdefer.f()
}

func keepAddAssign(errdefer int) {
	errdefer += 1
}

func badDeferParenTryTry() error {
	defer (g())?? // ERROR expression in defer must not be parenthesized
	return nil
}

func badGoParenTryTry() error {
	go (g())?? // ERROR expression in go must not be parenthesized
	return nil
}
