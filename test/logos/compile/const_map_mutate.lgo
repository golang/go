// errorcheck

package p

import "maps"

// M5-S4 const maps (SPEC T-201, T-Sec9): a const map is a const view. A
// standard-library parameter whose ParamMutated bit is 1 (maps.DeleteFunc
// deletes from its map) and a store through the map both fail with
// const_view_mutation.

const cm = map[string]int{"a": 1, "b": 2}

func cmDelete() {
	maps.DeleteFunc(cm, func(k string, v int) bool { return true }) // ERROR "const_view_mutation"
}

func cmStore() {
	cm["c"] = 3 // ERROR "const_view_mutation"
}
