// errorcheck

package p

import "comptime"

type Point struct {
	X int
	Y int
}

func assignIndex() {
	const for i, f := range comptime.Fields[Point]() {
		_ = f.Name
		_ = i
		i = 3 // ERROR "comptime::const_for_assign"
		i += 1 // ERROR "comptime::const_for_assign"
		i++ // ERROR "comptime::const_for_assign"
		i, _ = 1, 2 // ERROR "comptime::const_for_assign"
	}
}

func Describe[T any]() []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		out = append(out, f.Name)
	}
	return out
}

func Wrap[T any]() []string {
	return Describe[T]() // ERROR "comptime::generic_targ"
}

func Show[T any](v T) []string {
	var out []string
	const for _, f := range comptime.Fields[T]() {
		out = append(out, f.Name)
	}
	return out
}

func callWithoutExplicitArgs() {
	const for _, f := range comptime.Fields[Point]() {
		_ = Show(f.Name) // ERROR "comptime::generic_targ"
	}
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Dump() []string { // ERROR "comptime::generic_method"
	var out []string
	const for _, f := range comptime.Fields[T]() {
		out = append(out, f.Name)
	}
	return out
}
