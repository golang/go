// skip

package main

import "fmt"

// M22-S6 defect D3 (SPEC T-104.6, T-201): the compiler rejects chain
// methods on a `const []T` receiver, although they only read it. The
// archived Sec 11 example declares `ProcessBatch(ctx, batch const
// []CreateOrderReq)` and chains on batch. Reproduced separately: a generic
// Go helper rejects the view too, as `slices.Clone(xs)` on a `const []int`
// reports `S (type const []int) does not satisfy ~[]E`.
//
// want: [2 4]
// got:  xs.map undefined (type const []int has no field or method map)
//       [correctness::lambda_needs_target] lambda needs a target function type
//
// Flip the header to `// run` and add m22s6_d3_const_chain.out when fixed.

func double(xs const []int) []int {
	return xs.map(x => x * 2)
}

func main() {
	fmt.Println(double([]int{1, 2}))
}
