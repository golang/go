// skip

package main

import "fmt"

// M22-S6 defect D7 (SPEC Sec 11, T-Sec11, T-104.4): `logos eject` fails on
// a `$"..."` inside any lambda body, expression or block, although
// `logos run` prints n1. Sec 11 requires the ejected module to reproduce the
// native output, and the archived Sec 11 example holds `$"TX-{req.ID}"`
// inside the `WithLock(m => { ... })` block lambda. The shipped example
// keeps its interpolations outside lambdas.
//
// want: `logos eject -o out` succeeds and `go run .` in out prints n1
// got:  internal compiler error: logos eject: overlapping edits at byte offset <n>
//
// Flip the header to `// run`, add m22s6_d7_eject_interp_lambda.out, and
// pin the eject in a logos_eject_*.txt script when fixed.

func conv(g func(int) string) string { return g(1) }

func main() {
	fmt.Println(conv(x => $"n{x}"))
}
