// skip

package main

import "fmt"

// M22-S6 defect D1 (SPEC T-104.4, T-201): a scalar read through a const
// view keeps its const qualifier, and `$"..."` rejects it although the
// qualifier is erased before code generation. `n := p.N` keeps the const
// type too; `int64(p.N)` is the visible workaround.
//
// want: n=3 s=x
// got:  [correctness::interp_type] cannot interpolate value of type const int64
//       [correctness::interp_type] cannot interpolate value of type const string
//
// Flip the header to `// run` and add m22s6_d1_const_interp.out when fixed.

type P struct {
	N int64
	S string
}

func (p const *P) Show() string {
	return $"n={p.N} s={p.S}"
}

func main() {
	p := P{N: 3, S: "x"}
	fmt.Println(p.Show())
}
