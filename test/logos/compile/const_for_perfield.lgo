// errorcheck

// M7-S2 unrolled bodies are fully checked (SPEC Sec 2.5, T-205, #76):
// the body below is valid for the string field and invalid for the int
// field, so the iteration for N fails as an ordinary assignment error.

package p

import "comptime"

type Mixed struct {
	S string
	N int
}

func perField(v Mixed) {
	const for _, f := range comptime.Fields[Mixed]() {
		var s string = v.[f] // ERROR "cannot use v.\[f\] \(variable of type int\) as string value"
		_ = s
	}
}

func take(s string) {}

func perFieldCall(v Mixed) {
	const for _, f := range comptime.Fields[Mixed]() {
		take(v.[f]) // ERROR "cannot use v.\[f\] \(variable of type int\) as string value in argument to take"
	}
}
