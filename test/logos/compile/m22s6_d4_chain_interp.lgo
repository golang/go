package main

import "fmt"

// M22-S6 defect D4 (SPEC T-104.4, T-104.6): a `$"..."` inside a chain
// lambda body stays unlowered when the chain fragment is re-parsed as Go.
// The Sec 11 receipts line `.map(r => $"Order #{r.ID} by {r.Author}")`
// hits it. The same ICE occurs for `x => x.O ?? "none"` (U+003F) and for a
// block lambda holding `return $"..."`; a lambda that calls a helper
// function works.
//
// want: [n1 n2]
// got:  internal compiler error: logos: cannot parse chain fragment
//       "func() []string { _logos_ch..._f0 := func(x int) string { return $\"n{x}\" }; ..." :
//       logos-chain:2:100: invalid character U+0024 '$'
//
// Flip the header to `// run` and add m22s6_d4_chain_interp.out when fixed.

func main() {
	xs := []int{1, 2}
	fmt.Println(xs.map(x => $"n{x}"))
}
