// errorcheck

package p

import (
	"context"
	"logos/sync"
)

// concurrency::reentrant_withlock_deadlock (SPEC Sec 1.2, #167): inside a
// WithLock lambda, a call to WithLock on the same receiver expression,
// directly or through the synchronous call graph of same-package
// functions at any depth. A different receiver passes.

var global sync.Locked[int]

var other sync.Locked[int]

type Counter struct {
	mu sync.Locked[int]
	n  int
}

type Wrapper struct {
	inner Counter
	mu    sync.Locked[int]
}

type Fake struct{}

func (f *Fake) WithLock(fn func(*int)) {
	var n int
	fn(&n)
}

func lockGlobal() {
	global.WithLock(func(n *int) { *n++ })
}

func lockGlobalTwice() {
	lockGlobal()
	lockGlobal()
}

func lockParam(l *sync.Locked[int]) {
	l.WithLock(func(n *int) { *n++ })
}

func lockByValue(l sync.Locked[int]) {
	l.WithLock(func(n *int) { *n++ })
}

func lockParamTwoDeep(l *sync.Locked[int]) {
	lockParam(l)
}

func lockOther() {
	other.WithLock(func(n *int) { *n++ })
}

func (c *Counter) inc() {
	c.mu.WithLock(func(n *int) { *n++ })
}

func (c *Counter) incTwoDeep() {
	c.inc()
}

func (c *Counter) read() int {
	return c.n
}

func (c *Counter) outerDeadlocks() {
	c.mu.WithLock(func(n *int) {
		c.inc() // ERROR "reentrant_withlock_deadlock"
	})
}

func (c *Counter) outerTwoDeep() {
	c.mu.WithLock(func(n *int) {
		c.incTwoDeep() // ERROR "reentrant_withlock_deadlock"
	})
}

func (c *Counter) outerOtherMethod() {
	c.mu.WithLock(func(n *int) {
		*n += c.read()
	})
}

func directDepthZero() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		l.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
			*m++
		})
	})
}

func directThroughLambda() {
	var l sync.Locked[int]
	l.WithLock(n => {
		l.WithLock(m => { // ERROR "reentrant_withlock_deadlock"
			*m++
		})
	})
}

func directOnGlobal() {
	global.WithLock(func(n *int) {
		global.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
			*m++
		})
	})
}

func directOnField() {
	var c Counter
	c.mu.WithLock(func(n *int) {
		c.mu.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
			*m++
		})
	})
}

func directThroughPointer() {
	var l sync.Locked[int]
	p := &l
	p.WithLock(func(n *int) {
		p.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
			*m++
		})
	})
}

func directDeeplyNested() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		if *n > 0 {
			for range 2 {
				l.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
					*m++
				})
			}
		}
	})
}

func directThroughOtherLock() {
	var a, b sync.Locked[int]
	a.WithLock(func(n *int) {
		b.WithLock(func(m *int) {
			a.WithLock(func(k *int) { // ERROR "reentrant_withlock_deadlock"
				*k++
			})
		})
	})
}

func depthOneGlobal() {
	global.WithLock(func(n *int) {
		lockGlobal() // ERROR "reentrant_withlock_deadlock"
	})
}

func depthOneParameter() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		lockParam(&l) // ERROR "reentrant_withlock_deadlock"
	})
}

func depthOneParameterLambda() {
	var l sync.Locked[int]
	l.WithLock(n => {
		lockParam(&l) // ERROR "reentrant_withlock_deadlock"
	})
}

func depthOneMethodOnField() {
	var c Counter
	c.mu.WithLock(func(n *int) {
		c.inc() // ERROR "reentrant_withlock_deadlock"
	})
}

func depthTwoParameter() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		lockParamTwoDeep(&l) // ERROR "reentrant_withlock_deadlock"
	})
}

func depthTwoGlobal() {
	global.WithLock(func(n *int) {
		lockGlobalTwice() // ERROR "reentrant_withlock_deadlock"
	})
}

func passDifferentReceiver() {
	var a, b sync.Locked[int]
	a.WithLock(func(n *int) {
		b.WithLock(func(m *int) {
			*m += *n
		})
	})
}

func passDifferentGlobals() {
	global.WithLock(func(n *int) {
		lockOther()
	})
}

func passDifferentParameter() {
	var a, b sync.Locked[int]
	a.WithLock(func(n *int) {
		lockParam(&b)
	})
}

func passByValueCopy() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		lockByValue(l)
	})
}

func passDifferentCounters() {
	var a, b Counter
	a.mu.WithLock(func(n *int) {
		b.inc()
	})
}

func passDifferentField() {
	var w Wrapper
	w.mu.WithLock(func(n *int) {
		w.inner.inc()
	})
}

func passSequential() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) { *n++ })
	l.WithLock(func(n *int) { *n++ })
	lockParam(&l)
}

func passAfterLambda() {
	global.WithLock(func(n *int) { *n++ })
	lockGlobal()
}

func passShadowedReceiver() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		var l sync.Locked[int]
		l.WithLock(func(m *int) { *m++ })
	})
}

func passFakeWithLock() {
	var f Fake
	f.WithLock(func(n *int) {
		f.WithLock(func(m *int) { *m++ })
	})
}

func passDeferredNestedLiteral() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		inner := func() {
			l.WithLock(func(m *int) { *m++ })
		}
		_ = inner
	})
}

func passNoLambda() {
	var l sync.Locked[int]
	l.WithLock(setOne)
}

func setOne(n *int) {
	*n = 1
}

func chainOne(l *sync.Locked[int]) {
	l.WithLock(func(n *int) { *n++ })
}

func chainTwo(l *sync.Locked[int]) {
	chainOne(l)
}

func chainThree(l *sync.Locked[int]) {
	chainTwo(l)
}

func depthThreeParameter() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		chainThree(&l) // ERROR "reentrant_withlock_deadlock"
	})
}

func cyclePing(l *sync.Locked[int]) {
	cyclePong(l)
}

func cyclePong(l *sync.Locked[int]) {
	l.WithLock(func(n *int) { *n++ })
	cyclePing(l)
}

func cyclePositive() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		cyclePing(&l) // ERROR "reentrant_withlock_deadlock"
	})
}

func lockOtherTwice() {
	lockOther()
	lockOther()
}

func passTwoHopDifferent() {
	global.WithLock(func(n *int) {
		lockOtherTwice()
	})
}

var byName sync.Locked[int]

func relock(n *int) {
	byName.WithLock(func(k *int) { // ERROR "reentrant_withlock_deadlock"
		*k++
	})
}

func namedCallbackPositive() {
	byName.WithLock(relock)
}

func (c *Counter) set(n *int) {
	c.mu.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
		*m++
	})
}

func methodValueCallbackPositive() {
	var c Counter
	c.mu.WithLock(c.set)
}

func directImmediateLiteral() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		func() {
			l.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
				*m++
			})
		}()
	})
}

func directDeferredLiteral() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		defer func() {
			l.WithLock(func(m *int) { // ERROR "reentrant_withlock_deadlock"
				*m++
			})
		}()
	})
}

func sink(v int) {
}

func sinkFunc(f func()) {
}

func lockAndReturn() int {
	global.WithLock(func(n *int) { *n++ })
	return 0
}

func spawnLockGlobal(ctx context.Context) error {
	go group (ctx) {
		go lockGlobal()
	}
	return nil
}

func passGoSpawnedCall(ctx context.Context) {
	global.WithLock(func(n *int) {
		err := spawnLockGlobal(ctx)
		if err != nil {
			panic(err)
		}
	})
}

func spawnDirectLock(ctx context.Context, l *sync.Locked[int]) error {
	go group (ctx) {
		go l.WithLock(func(m *int) { *m++ })
	}
	return nil
}

func passGoSpawnedDirectLock(ctx context.Context) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		err := spawnDirectLock(ctx, &l)
		if err != nil {
			panic(err)
		}
	})
}

func spawnLiteralLock(ctx context.Context, l *sync.Locked[int]) error {
	go group (ctx) {
		go func() {
			l.WithLock(func(m *int) { *m++ })
		}()
	}
	return nil
}

func passGoSpawnedLiteral(ctx context.Context) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		err := spawnLiteralLock(ctx, &l)
		if err != nil {
			panic(err)
		}
	})
}

func spawnFuncArgLock(ctx context.Context, l *sync.Locked[int]) error {
	go group (ctx) {
		go sinkFunc(func() {
			l.WithLock(func(m *int) { *m++ })
		})
	}
	return nil
}

func passGoSpawnedFunctionLiteralArgument(ctx context.Context) {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		err := spawnFuncArgLock(ctx, &l)
		if err != nil {
			panic(err)
		}
	})
}

func spawnSinkLockAndReturn(ctx context.Context) error {
	go group (ctx) {
		go sink(lockAndReturn())
	}
	return nil
}

func goArgumentEvaluationPositive(ctx context.Context) {
	global.WithLock(func(n *int) {
		err := spawnSinkLockAndReturn(ctx) // ERROR "reentrant_withlock_deadlock"
		if err != nil {
			panic(err)
		}
	})
}

func passDeferredDifferentLock() {
	var l sync.Locked[int]
	l.WithLock(func(n *int) {
		defer lockOther()
	})
}

type Node struct {
	mu   sync.Locked[int]
	next *Node?
}

func (n *Node) walk() {
	next := n.next
	if next == nil {
		return
	}
	next.walk()
	next.mu.WithLock(func(k *int) { *k++ })
}

func passRecursiveWalkTerminates() {
	n := &Node{next: &Node{}}
	n.mu.WithLock(func(k *int) {
		n.walk()
	})
}

func relockGlobal(n *int) {
	global.WithLock(func(k *int) { *k++ })
}

func h() {
	other.WithLock(relockGlobal)
}

func outer() {
	global.WithLock(func(n *int) {
		h() // ERROR "reentrant_withlock_deadlock"
	})
}

func relockOuter(n *int) {
	other.WithLock(relockGlobal) // ERROR "reentrant_withlock_deadlock"
}

func outer2() {
	global.WithLock(relockOuter)
}

func (c *Counter) relockMu(n *int) {
	c.mu.WithLock(func(m *int) { *m++ })
}

func (c *Counter) grabOther(o *Counter) {
	o.mu.WithLock(c.relockMu)
}

func methodCallbackTransitive() {
	var c, o Counter
	c.mu.WithLock(func(n *int) {
		c.grabOther(&o) // ERROR "reentrant_withlock_deadlock"
	})
}
