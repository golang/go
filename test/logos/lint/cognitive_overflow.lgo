// Cognitive score: 14, 15, and 16.

func score14(ctx context.Context, done <-chan struct{}, xs []int, ok bool) int {
	n := 0
	if ok {
		n++
	}
	for _, x := range xs {
		n += x
	}
	switch n {
	case 1:
	case 2:
	case 3:
	default:
	}
	select {
	case <-ctx.Done():
		return n
	case <-done:
	default:
	}
	if n > 1 && ok || n < -1 {
		n++
	}
	if n > 2 {
		if ok {
			n++
		}
	}
	return n
}

func score15(ctx context.Context, done <-chan struct{}, xs []int, ok bool) int {
	n := 0
	if ok {
		n++
	}
	for _, x := range xs {
		n += x
	}
	switch n {
	case 1:
	case 2:
	case 3:
	default:
	}
	select {
	case <-ctx.Done():
		return n
	case <-done:
	default:
	}
	if n > 1 && ok || n < -1 {
		n++
	}
	if n > 2 {
		if ok {
			n++
		}
	}
	if n > 5 {
		n--
	}
	return n
}

func score16(ctx context.Context, done <-chan struct{}, xs []int, ok bool) int { // ERROR "cognitive_overflow.*cognitive score 16 exceeds 15$"
	n := 0
	if ok {
