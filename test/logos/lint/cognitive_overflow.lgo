	case <-done:
	default:
	}
	if n > 1 && ok || n < -1 {
		n++
	}
	if n > 2 {
		if ok {
			n++
		}
	}
	if n > 5 {
		n--
	}
	if n > 6 {
		n--
	}
	return n
}

