// errorcheck

package p

import (
	"errors"
	"fmt"
	"os"
)

// M9-S2 slop::err_chain_reset (SPEC Sec 1.2): fmt.Errorf that formats an
// error operand with a verb other than %w, or that passes err.Error(),
// cuts the chain errors.Is and errors.As follow. The rule is deny, so the
// findings below fail the lint run and //logos:allow silences one.

var errBase = errors.New("base")

type codeErr struct{ code int }

func (e *codeErr) Error() string { return "code" }

type notError struct{}

func (notError) Error(n int) string { return "not an error" }

const constFormat = "const: %v"

func verbV(err error) error {
	return fmt.Errorf("read: %v", err) // ERROR "err_chain_reset.*err with %v"
}

func verbS(err error) error {
	return fmt.Errorf("read: %s", err) // ERROR "err_chain_reset.*err with %s"
}

func verbQ(err error) error {
	return fmt.Errorf("read: %q", err) // ERROR "err_chain_reset.*err with %q"
}

func verbPlusV(err error) error {
	return fmt.Errorf("read: %+v", err) // ERROR "err_chain_reset.*err with %\+v"
}

func verbT(err error) error {
	return fmt.Errorf("type: %T", err) // ERROR "err_chain_reset.*err with %T"
}

func errorCallS(err error) error {
	return fmt.Errorf("read: %s", err.Error()) // ERROR "err_chain_reset.*passes err.Error"
}

func errorCallV(err error) error {
	return fmt.Errorf("read: %v", err.Error()) // ERROR "err_chain_reset.*passes err.Error"
}

func errorCallConcat(err error) error {
	return fmt.Errorf("read: " + err.Error()) // ERROR "err_chain_reset.*passes err.Error"
}

func concreteOperand(ce *codeErr) error {
	return fmt.Errorf("code: %v", ce) // ERROR "err_chain_reset.*ce with %v"
}

func concreteErrorCall(ce *codeErr) error {
	return fmt.Errorf("code: %s", ce.Error()) // ERROR "err_chain_reset.*passes ce.Error"
}

func secondOperand(name string, err error) error {
	return fmt.Errorf("%s: %v", name, err) // ERROR "err_chain_reset.*err with %v"
}

func thirdOperand(a, b int, err error) error {
	return fmt.Errorf("%d %d %v", a, b, err) // ERROR "err_chain_reset.*err with %v"
}

func indexedOperand(err error, n int) error {
	return fmt.Errorf("%[2]v %[1]d", n, err) // ERROR "err_chain_reset.*err with %\[2\]v"
}

func starWidth(err error) error {
	return fmt.Errorf("%*d %v", 3, 4, err) // ERROR "err_chain_reset.*err with %v"
}

func percentLiteral(err error) error {
	return fmt.Errorf("100%% %v", err) // ERROR "err_chain_reset.*err with %v"
}

func constantFormat(err error) error {
	return fmt.Errorf(constFormat, err) // ERROR "err_chain_reset.*err with %v"
}

func wrappedAndPlain(err, other error) error {
	return fmt.Errorf("%w: %v", other, err) // ERROR "err_chain_reset.*err with %v"
}

func inClosure(err error) func() error {
	return func() error {
		return fmt.Errorf("x: %v", err) // ERROR "err_chain_reset.*err with %v"
	}
}

func inLoGoLambda() {
	var wrap func(error) error = e => fmt.Errorf("wrap: %v", e) // ERROR "err_chain_reset.*e with %v"
	_ = wrap
}

func afterTry(path string, inner error) error {
	os.Remove(path)?
	return fmt.Errorf("after remove: %v", inner) // ERROR "err_chain_reset.*inner with %v"
}

func wrapW(err error) error {
	return fmt.Errorf("read: %w", err)
}

func wrapTwice(a, b error) error {
	return fmt.Errorf("%w and %w", a, b)
}

func wrapWithWidth(err error) error {
	return fmt.Errorf("%*d %w", 3, 4, err)
}

func wrapIndexed(err error, n int) error {
	return fmt.Errorf("%[2]w %[1]d", n, err)
}

func wrapLambda() {
	var wrap func(error) error = e => fmt.Errorf("wrap: %w", e)
	_ = wrap
}

func nonErrorOperands(n int, s string, c *codeErr) error {
	return fmt.Errorf("n=%v s=%s c=%d", n, s, c.code)
}

func anyOperand(v any) error {
	return fmt.Errorf("v=%v", v)
}

func nilOperand() error {
	return fmt.Errorf("x: %v", nil)
}

func sprintfNotErrorf(err error) string {
	return fmt.Sprintf("read: %v", err)
}

func dynamicSpread(format string, args ...any) error {
	return fmt.Errorf(format, args...)
}

func dynamicFormat(format string, err error) error {
	return fmt.Errorf(format, err)
}

func otherErrorMethod(t notError) error {
	return fmt.Errorf("t: %s", t.Error(1))
}

func errorOutsideErrorf(err error) string {
	return err.Error()
}

func plainString(s string) error {
	return fmt.Errorf("plain %s", s)
}

func allowed(err error) error {
	//logos:allow(slop::err_chain_reset)
	return fmt.Errorf("hidden: %v", err)
}
