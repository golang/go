// errorcheck

package p

func constSwitchSelected(n int) int { // ERROR "correctness::infinite_recursion"
	const switch int {
	case ~string:
		return n
	case int:
		return constSwitchSelected(n)
	}
	return constSwitchSelected(n)
}

func constSwitchDeadBranch(n int) int {
	const switch int {
	case ~string:
		return constSwitchDeadBranch(n)
	case int:
		return n
	}
	return n
}

func constSwitchGenericSelected[T any](n T) T { // ERROR "correctness::infinite_recursion"
	const switch int {
	case ~string:
		return n
	case int:
		return constSwitchGenericSelected[T](n)
	}
	return constSwitchGenericSelected[T](n)
}

func constSwitchGenericDead[T any](n T) T {
	const switch int {
	case ~string:
		return constSwitchGenericDead[T](n)
	case int:
		return n
	}
	return n
}
