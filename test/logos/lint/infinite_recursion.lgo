// errorcheck

package p

import "context"

func selfDirect(n int) int { return selfDirect(n) } // ERROR "correctness::infinite_recursion"

func selfAfterCall(n int) int { // ERROR "correctness::infinite_recursion"
	if n > 0 {
		selfAfterCall(n)
		return n
	}
	return selfAfterCall(n)
}

func selfFallthrough(n int) int { // ERROR "correctness::infinite_recursion"
	if n > 0 {
		selfFallthrough(n)
	}
	return selfFallthrough(n)
}

func selfSwitch(n int) int { // ERROR "correctness::infinite_recursion"
	switch n {
	case 0:
		return selfSwitch(n)
	default:
		return selfSwitch(n)
	}
}

func selfSwitchFallthrough(n int) int { // ERROR "correctness::infinite_recursion"
	switch n {
	case 0:
		return selfSwitchFallthrough(n)
	case 1:
		return selfSwitchFallthrough(n)
	}
	return selfSwitchFallthrough(n)
}

func selfNested(n int) int { // ERROR "correctness::infinite_recursion"
	if n > 0 {
		if n > 1 {
			return selfNested(n)
		}
	}
	return selfNested(n)
}

func nestedNoCall(n int) int {
	if n > 0 {
		if n > 1 {
			return n
		}
	}
	return nestedNoCall(n)
}

func guarded(n int) int {
	if n > 0 {
		return n
	}
	return guarded(n)
}

func guardNoCall(n int) int {
	if n > 0 {
		return n
	}
	return guardNoCall(n)
}

func partialSwitch(n int) int {
	switch n {
	case 0:
		return 0
	default:
		return partialSwitch(n)
	}
}

func switchNoDefault(n int) int {
	switch n {
	case 0:
		return switchNoDefault(n)
	}
	return 0
}

func differentArgs(n int) int { return differentArgs(n - 1) }

func reassigned(n int) int {
	n--
	return reassigned(n)
}

func loop(n int) int { return loop(n) } // ERROR "infinite_recursion"

func tick() { tick() } // ERROR "infinite_recursion"

type counter struct{ n int }

func (c counter) next(n int) int { return c.next(n) } // ERROR "infinite_recursion"

func guardedDecrement(n int) int {
	if n <= 0 {
		return 0
	}
	return guardedDecrement(n - 1)
}

func countdown(n int) int {
	if n == 0 {
		return 0
	}
	return countdown(n - 1)
}

func bump(n int) int {
	n++
	return bump(n)
}

func ping(n int) int { return pong(n) }

func pong(n int) int { return ping(n) }

func read(n int) int {
	println(n)
	return n
}

func rangeStage(ctx context.Context, xs []int) error {
	for range xs.group(ctx, limit = 2).map(x => x) {
	}
	return rangeStage(ctx, xs)
}

func rangeStageUnordered(ctx context.Context, xs []int) error {
	for range xs.group(ctx, limit = 2).unordered().map(x => x) {
	}
	return rangeStageUnordered(ctx, xs)
}

func valueStage(ctx context.Context, xs []int) error { // ERROR "correctness::infinite_recursion"
	_, err := xs.group(ctx, limit = 2).map(x => x)
	println(err == nil)
	return valueStage(ctx, xs)
}

func rangePlainChain(ctx context.Context, xs []int) error { // ERROR "correctness::infinite_recursion"
	for range xs.map(x => x) {
	}
	return rangePlainChain(ctx, xs)
}
