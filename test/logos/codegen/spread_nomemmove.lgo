// asmcheck

package spreadcheck

// M6-S4 codegen check (SPEC T-104.5, #146): a 4 KB struct self-update
// lowers to one tuple assignment of the explicit fields, so the update
// performs no full copy.

type Big struct {
	X   int
	Y   int
	Pad [4080]byte
}

var cur Big

func update() {
	cur = Big{X: cur.Y, ..cur} // amd64:-"runtime.memmove" arm64:-"runtime.memmove"
}
