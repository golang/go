// asmcheck -goexperiment simd

package main

// M14-S1 attack (SPEC Sec 2.4, T-204.2): an alias of a fixed-width
// numeric kind is the same type as its target, so it takes the vector
// form exactly as the predeclared kind does. byte is an alias of uint8
// and vectorizes. int stays scalar: its pointer is not the *[N]int64
// the archsimd loaders take.

type f32 = float32

//go:noinline
func addAlias(a, b [8]f32) [8]f32 {
	// amd64:"VADDPS"
	// arm64:"VFADD V[0-9]+\\.S4"
	return a + b
}

//go:noinline
func addByte(a, b [32]byte) [32]byte {
	// amd64:"VPADDB"
	// arm64:"VADD V[0-9]+\\.B16"
	return a + b
}

//go:noinline
func addInt(a, b [4]int) [4]int {
	// amd64:-"VPADD"
	// arm64:-"VADD"
	return a + b
}

func main() {
	var a, b [8]f32
	var c, d [32]byte
	var e, f [4]int
	println(addAlias(a, b)[0], addByte(c, d)[0], addInt(e, f)[0])
}
