// asmcheck -O=3

package main

import (
	"fmt"
	"slices"
)

// M13 row #134 (SPEC Sec 1.5, T-105, T-302), loGo/s side of
// recursive_stack.go. At -O=3 every variable-size make and every append
// onto a non-escaping slice that lands in a function frame takes a
// 4096-byte stack buffer. Inside a recursive call-graph cycle the buffer
// stays at the upstream 32 bytes, so recursion depth does not multiply the
// tier buffers; a non-recursive function keeps the full tier buffer. The
// interpolation lowers to one variable-size make in the recursive
// function itself; the helpers add inlined buffers and call
// slices.Contains so that the inliner instantiates a generic function
// while the cycle marks of this package are live.

type node struct {
	id   int
	name string
	kids []*node
	data []byte
}

func sumA(b []byte) int {
	buf := make([]byte, 0, len(b))
	for _, c := range b {
		buf = append(buf, c)
	}
	if slices.Contains(buf, 0) {
		return -1
	}
	return len(buf)
}

func sumB(b []byte) int {
	buf := make([]byte, 0, len(b)+1)
	for _, c := range b {
		buf = append(buf, c+1)
	}
	if slices.Contains(buf, 1) {
		return -1
	}
	return len(buf)
}

// label sizes an interpolated string in its own frame, then recurses.
//
// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{1,3}-"
func label(n *node) int {
	t := $"id={n.id} name={n.name}"
	s := len(t)
	for _, k := range n.kids {
		s += label(k)
	}
	return s
}

// total inlines two helpers (four buffers) into a recursive frame.
//
// amd64:"TEXT .*, [$][0-9]{1,3}-"
// arm64:"TEXT .*, [$][0-9]{1,3}-"
func total(n *node) int {
	if n == nil {
		return 0
	}
	s := sumA(n.data) + sumB(n.data)
	for _, k := range n.kids {
		s += total(k)
	}
	return s
}

// flat is not recursive, so it keeps the full tier buffers.
//
// amd64:"TEXT .*, [$][0-9]{5,}-"
// arm64:"TEXT .*, [$][0-9]{5,}-"
func flat(n *node) int {
	if n == nil {
		return 0
	}
	return sumA(n.data) + sumB(n.data)
}

// flatLabel is not recursive, so its interpolation keeps the full buffer.
//
// amd64:"TEXT .*, [$][0-9]{4,}-"
// arm64:"TEXT .*, [$][0-9]{4,}-"
func flatLabel(n *node) int {
	t := $"id={n.id} name={n.name}"
	return len(t)
}

func main() {
	n := &node{id: 1, name: "a", data: []byte("abc"), kids: []*node{{id: 2, name: "b", data: []byte("de")}}}
	fmt.Println(label(n), total(n), flat(n), flatLabel(n))
}
