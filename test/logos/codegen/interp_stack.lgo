// asmcheck -O=3

package main

import "fmt"
// M6-S1 codegen check (SPEC T-104.4): interpolation lowers to one
// make([]byte, 0, n). Constant bounds stack-allocate through the
// constant-cap path whatever the threshold, so bound4095 and bound4096
// (literal bytes plus 5 for one bool operand) never need
// runtime.makeslice. bound4097 adds a dynamic string operand, so its
// size is variable and crosses the active threshold (4096 bytes at -O=3,
// T-302): the variable-make slow branch with runtime.makeslice must be
// present. M13-S1 executes this check at -O=3 (deviation: constant 4097
// alone cannot reach the slow branch, because constant caps bypass the
// threshold in walk).

func bound4095(b bool) int {
	// amd64:-"CALL.*runtime.makeslice" arm64:-"CALL.*runtime.makeslice"
	t := $"{b}"
	return len(t)
}

func bound4096(b bool) int {
	// amd64:-"CALL.*runtime.makeslice" arm64:-"CALL.*runtime.makeslice"
	t := $"{b}"
	return len(t)
}

func bound4097(b bool, pad string) int {
	// amd64:"CALL.*runtime.makeslice" arm64:"CALL.*runtime.makeslice"
	t := $"{b}{pad}"
	return len(t)
}

func main() {
	fmt.Println(bound4095(true), bound4096(false), bound4097(true, ""))
}
