	E ZShape   `json:"e,omitempty"`
	L []ZShape `json:"l"`
}

type unionZeroMirror UnionZero

func TestStaticEncoderUnionOmitZero(t *testing.T) {
	for i, r := range []UnionZero{{}, {S: ZCircle{}, E: ZSquare{}}, {S: ZSquare{S: 2}, L: []ZShape{ZCircle{R: 1}, ZSquare{}}}} {
		sameOutcome(t, "union omit "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(unionZeroMirror(r))))
	}
}

type TKey int

func (k TKey) MarshalText() ([]byte, error) {
	return []byte("k" + string(rune('a'+int(k)))), nil
}

type PKey struct {
	N int
}

func (k *PKey) MarshalText() ([]byte, error) {
	return []byte("p" + string(rune('a'+k.N))), nil
}

type SKey string

func (k SKey) MarshalText() ([]byte, error) {
	return []byte("ignored"), nil
}

type BadText int

func (BadText) MarshalText() ([]byte, error) {
	return nil, errBadText
}

var errBadText = errors.New("bad text key")

type KeyBox struct {
	T     map[TKey]int    `json:"t"`
	P     map[*PKey]int   `json:"p"`
	S     map[SKey]int    `json:"s"`
	NoGen any             `json:"-"`
}

type KeyRoot struct {
	B   KeyBox             `json:"b"`
	Bad []map[BadText]int  `json:"bad"`
}

type keyRootMirror KeyRoot

func TestStaticEncoderMapKeys(t *testing.T) {
	r := KeyRoot{B: KeyBox{T: map[TKey]int{2: 1, 0: 2}, P: map[*PKey]int{&PKey{N: 1}: 1, &PKey{N: 0}: 2}, S: map[SKey]int{"b": 1, "a": 2}}}
	sameOutcome(t, "map keys", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(keyRootMirror(r))))
	var gerr, werr error
	bad := KeyRoot{Bad: []map[BadText]int{{1: 1}}}
	_, gerr = bad.MarshalJSON()
	_, werr = json.Marshal(keyRootMirror(bad))
	if gerr == nil || werr == nil {
		t.Fatalf("failing MarshalText key: generated error %v, encoding/json error %v", gerr, werr)
	}
	if !strings.Contains(gerr.Error(), "bad text key") {
		t.Fatalf("failing MarshalText key error %q lost the method error", gerr.Error())
	}
}

func TestStaticEncoderTextKeyMutation(t *testing.T) {
	t.Run("mutating text keys", func(t *testing.T) {
		for _, c := range []struct {
			name  string
			build func() MutKeyRoot
		}{
			{"value singleton", func() MutKeyRoot { return MutKeyRoot{One: []map[MutTextKey]int{newMutTextMap("a")}} }},
			{"value two entries", func() MutKeyRoot { return MutKeyRoot{Two: []map[MutTextKey]int{newMutTextMap("a", "b")}} }},
			{"pointer singleton", func() MutKeyRoot { return MutKeyRoot{POne: []map[*MutPtrKey]int{newMutPtrTextMap("a")}} }},
			{"pointer two entries", func() MutKeyRoot { return MutKeyRoot{PTwo: []map[*MutPtrKey]int{newMutPtrTextMap("a", "b")}} }},
			{"nan key", func() MutKeyRoot { return MutKeyRoot{Nan: []map[NanTextKey]int{{{f: math.NaN()}: 7}}} }},
		} {
			t.Run(c.name, func(t *testing.T) {
				sameOutcome(t, c.name, outcomeOf(c.build().MarshalJSON()), outcomeOf(json.Marshal(mutKeyRootMirror(c.build()))))
			})
		}
	})
}

func TestStaticEncoderInterfaceTextKeys(t *testing.T) {
	t.Run("interface text key", func(t *testing.T) {
		okIface := TMIfaceRoot{OK: []map[encoding.TextMarshaler]int{{TKey(2): 1, SKey("x"): 2}}}
		sameOutcome(t, "interface text key", outcomeOf(okIface.MarshalJSON()), outcomeOf(json.Marshal(tmIfaceMirror(okIface))))
	})
	t.Run("nil interface text key", func(t *testing.T) {
		nilIface := TMIfaceRoot{Bad: []map[encoding.TextMarshaler]int{{nil: 3}}}
		got, gpanic := safeMarshalOutcome(func() ([]byte, error) { return nilIface.MarshalJSON() })
		want, wpanic := safeMarshalOutcome(func() ([]byte, error) { return json.Marshal(tmIfaceMirror(nilIface)) })
		if gpanic != nil {
			t.Fatalf("nil interface text key: generated panicked with %v, encoding/json panicked with %v, want a generated encoding error", gpanic, wpanic)
		}
		if got.err == nil {
			t.Fatalf("nil interface text key: generated encoded %s or panicked with %v, want a generated encoding error", got.b, gpanic)
		}
		if wpanic == nil && want.err == nil {
			t.Fatalf("nil interface text key: encoding/json unexpectedly accepted a nil interface text key, encoded %s", want.b)
		}
	})
}

func TestStaticEncoderTextKeyTypeNames(t *testing.T) {
	t.Run("named map text-key error", func(t *testing.T) {
		namedBad := NamedKeyRoot{Named: []BadTextMap{{1: 1}}}
		_, gerr := namedBad.MarshalJSON()
		_, werr := json.Marshal(namedKeyRootMirror(namedBad))
		if gerr == nil || werr == nil {
			t.Fatalf("named map text-key error: generated error %v, encoding/json error %v, want both", gerr, werr)
		}
		wantNamed := reflect.TypeFor[BadTextMap]().String()
		if !strings.Contains(gerr.Error(), wantNamed) || !strings.Contains(gerr.Error(), errBadText.Error()) {
			t.Fatalf("named map text-key error %q, want type %q and method error %q (encoding/json %q)", gerr.Error(), wantNamed, errBadText.Error(), werr.Error())
		}
	})
	t.Run("unnamed map text-key error", func(t *testing.T) {
		plainBad := NamedKeyRoot{Plain: []map[BadText]int{{1: 1}}}
		_, gerr := plainBad.MarshalJSON()
		_, werr := json.Marshal(namedKeyRootMirror(plainBad))
		if gerr == nil || werr == nil {
			t.Fatalf("unnamed map text-key error: generated error %v, encoding/json error %v, want both", gerr, werr)
		}
		wantUnnamed := reflect.TypeFor[map[BadText]int]().String()
		if !strings.Contains(gerr.Error(), wantUnnamed) || !strings.Contains(gerr.Error(), errBadText.Error()) {
			t.Fatalf("unnamed map text-key error %q, want type %q and method error %q (encoding/json %q)", gerr.Error(), wantUnnamed, errBadText.Error(), werr.Error())
		}
	})
}

type MutTextKey struct {
	m  *map[MutTextKey]int
	id string
}

func (k MutTextKey) MarshalText() ([]byte, error) {
	(*k.m)[k] = 99
	return []byte(k.id), nil
}

func newMutTextMap(ids ...string) map[MutTextKey]int {
	m := map[MutTextKey]int{}
	for i, id := range ids {
		m[MutTextKey{m: &m, id: id}] = i + 1
	}
	return m
}

type MutPtrKey struct {
	m  *map[*MutPtrKey]int
	id string
}

func (k *MutPtrKey) MarshalText() ([]byte, error) {
	(*k.m)[k] = 99
	return []byte(k.id), nil
}

func newMutPtrTextMap(ids ...string) map[*MutPtrKey]int {
	m := map[*MutPtrKey]int{}
	for i, id := range ids {
		m[&MutPtrKey{m: &m, id: id}] = i + 1
	}
	return m
}

type NanTextKey struct {
	f float64
}

func (k NanTextKey) MarshalText() ([]byte, error) {
	return []byte("nan"), nil
}

type BadTextMap map[BadText]int

type MutKeyRoot struct {
	One  []map[MutTextKey]int `json:"one"`
	Two  []map[MutTextKey]int `json:"two"`
	POne []map[*MutPtrKey]int `json:"pone"`
	PTwo []map[*MutPtrKey]int `json:"ptwo"`
	Nan  []map[NanTextKey]int `json:"nan"`
}

type mutKeyRootMirror MutKeyRoot

type TMIfaceRoot struct {
	Bad []map[encoding.TextMarshaler]int `json:"bad"`
	OK  []map[encoding.TextMarshaler]int `json:"ok"`
}

type tmIfaceMirror TMIfaceRoot

type NamedKeyRoot struct {
	Named []BadTextMap      `json:"named"`
	Plain []map[BadText]int `json:"plain"`
}

type namedKeyRootMirror NamedKeyRoot

type CNodeMap map[string](*CNode?)

type CNodeList [](*CNode?)

type CNode struct {
	Name string    `json:"name"`
	Kids []any     `json:"kids"`
	M    CNodeMap  `json:"m"`
	S    CNodeList `json:"s"`
}

type CNodeMirrorMap map[string](*CNodeMirror?)

type CNodeMirrorList [](*CNodeMirror?)

type CNodeMirror struct {
	Name  string          `json:"name"`
	Kids  []any           `json:"kids"`
	M     CNodeMirrorMap  `json:"m"`
	S     CNodeMirrorList `json:"s"`
	NoGen any             `json:"-"`
}

type CHolder struct {
	C *CNode?
}

type CHolderMirror struct {
	C *CNodeMirror?
}

type cycleCase struct {
	name string
	link func(c *CNode, m *CNodeMirror)
}

func TestStaticEncoderCycleAcrossDynamicValues(t *testing.T) {
	cases := []cycleCase{
		{"interface", func(c *CNode, m *CNodeMirror) { c.Kids, m.Kids = []any{c}, []any{m} }},
		{"interface map", func(c *CNode, m *CNodeMirror) {
			c.Kids, m.Kids = []any{map[string]any{"c": c}}, []any{map[string]any{"c": m}}
		}},
		{"interface slice", func(c *CNode, m *CNodeMirror) { c.Kids, m.Kids = []any{[]any{c}}, []any{[]any{m}} }},
		{"interface struct", func(c *CNode, m *CNodeMirror) {
			c.Kids, m.Kids = []any{CHolder{C: c}}, []any{CHolderMirror{C: m}}
		}},
		{"map edge", func(c *CNode, m *CNodeMirror) {
			c.M, m.M = CNodeMap{"self": c}, CNodeMirrorMap{"self": m}
		}},
		{"slice edge", func(c *CNode, m *CNodeMirror) {
			c.S, m.S = CNodeList{c}, CNodeMirrorList{m}
		}},
		{"map edge to interface", func(c *CNode, m *CNodeMirror) {
			inner, innerMirror := map[string]any{}, map[string]any{}
			inner["c"], innerMirror["c"] = c, m
			c.Kids, m.Kids = []any{inner}, []any{innerMirror}
			c.M, m.M = CNodeMap{"next": c}, CNodeMirrorMap{"next": m}
		}},
	}
	for _, tc := range cases {
		c, m := &CNode{Name: "c"}, &CNodeMirror{Name: "c"}
		tc.link(c, m)
		_, gerr := c.MarshalJSON()
		_, werr := json.Marshal(m)
		sameCycle(t, tc.name, gerr, werr)
	}
}

type UWrap struct {
	G *CNode?
}

func (u UWrap) MarshalJSON() ([]byte, error) {
	g := u.G
	if g == nil {
		return []byte("null"), nil
	}
	return json.Marshal(g)
}

type UHolder struct {
	U  UWrap `json:"u"`
	Us []any `json:"us"`
}

type uHolderMirror UHolder

func TestStaticEncoderUserMethodMarshalsGenerated(t *testing.T) {
	inner := &CNode{Name: "inner", Kids: []any{"k", map[string]any{"n": json.Number("1")}}}
	r := UHolder{U: UWrap{G: inner}, Us: []any{UWrap{G: inner}, UWrap{}}}
	sameOutcome(t, "user method marshals a generated struct", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(uHolderMirror(r))))
}

type DNode struct {
	Next []any `json:"next"`
}

type DNodeMirror struct {
	Next  []any `json:"next"`
	NoGen any   `json:"-"`
}

type DRoot struct {
	Root DNode `json:"root"`
}

type DRootMirror struct {
	Root  DNodeMirror `json:"root"`
	NoGen any         `json:"-"`
}

type TNode struct {
	Tags []int   `json:"tags"`
	Next *TNode? `json:"next,omitempty"`
}

type TNodeMirror struct {
	Tags  []int         `json:"tags"`
	Next  *TNodeMirror? `json:"next,omitempty"`
	NoGen any           `json:"-"`
}

func deepDirect(n int, end []any) (DNode, DNodeMirror) {
	g, m := DNode{Next: end}, DNodeMirror{Next: end}
	for range n {
		g, m = DNode{Next: []any{g}}, DNodeMirror{Next: []any{m}}
	}
	return g, m
}

func deepThroughMaps(n int, end []any) (DNode, DNodeMirror) {
	g, m := DNode{Next: end}, DNodeMirror{Next: end}
	for range n {
		g, m = DNode{Next: []any{map[string]any{"d": g}}}, DNodeMirror{Next: []any{map[string]any{"d": m}}}
	}
	return g, m
}

func deepThroughPointers(n int, end []any) (DNode, DNodeMirror) {
	g, m := DNode{Next: end}, DNodeMirror{Next: end}
	for range n {
		inner, innerMirror := g, m
		g, m = DNode{Next: []any{&inner}}, DNodeMirror{Next: []any{&innerMirror}}
	}
	return g, m
}

func deepTags(n int, tags []int) (TNode, TNodeMirror) {
	g, m := TNode{Tags: tags}, TNodeMirror{Tags: tags}
	for range n {
		inner, innerMirror := g, m
		g, m = TNode{Next: &inner}, TNodeMirror{Next: &innerMirror}
	}
	return g, m
}

type depthStep struct {
	delta int
	name  string
}

var depthSteps = []depthStep{{-1, "limit-1"}, {0, "limit"}, {1, "limit+1"}}

func jsonDepthBounded() bool {
	var v any
	for range 10001 {
		v = []any{v}
	}
	_, err := json.Marshal(v)
	return err != nil
}

type depthChain struct {
	name  string
	limit int
	run   func(n int) (outcome, outcome)
}

func checkDepthChains(t *testing.T, chains []depthChain) {
	t.Helper()
	bounded := jsonDepthBounded()
	for _, c := range chains {
		for _, step := range depthSteps {
			gen, std := c.run(c.limit + step.delta)
			label := c.name + ", n = " + step.name
			if want := step.delta <= 0 || !bounded; (std.err == nil) != want {
				t.Fatalf("%s: encoding/json error %v, want success %v", label, std.err, want)
			}
			sameDepthOutcome(t, label, gen, std)
		}
	}
}

func dynamicDepthChains(tail string, end []any) []depthChain {
	return []depthChain{
		{"direct, " + tail, 4999, func(n int) (outcome, outcome) {
			g, m := deepDirect(n, end)
			return outcomeOf(g.MarshalJSON()), outcomeOf(json.Marshal(m))
		}},
		{"direct under a root object, " + tail, 4999, func(n int) (outcome, outcome) {
			g, m := deepDirect(n, end)
			return outcomeOf(DRoot{Root: g}.MarshalJSON()), outcomeOf(json.Marshal(DRootMirror{Root: m}))
		}},
		{"through maps, " + tail, 3333, func(n int) (outcome, outcome) {
			g, m := deepThroughMaps(n, end)
			return outcomeOf(g.MarshalJSON()), outcomeOf(json.Marshal(m))
		}},
		{"through interface pointers, " + tail, 4999, func(n int) (outcome, outcome) {
			g, m := deepThroughPointers(n, end)
			return outcomeOf(g.MarshalJSON()), outcomeOf(json.Marshal(m))
		}},
		{"through interface pointers under a root object, " + tail, 4999, func(n int) (outcome, outcome) {
			g, m := deepThroughPointers(n, end)
			return outcomeOf(DRoot{Root: g}.MarshalJSON()), outcomeOf(json.Marshal(DRootMirror{Root: m}))
		}},
	}
}

func TestStaticEncoderDepthAcrossDynamicValues(t *testing.T) {
	checkDepthChains(t, dynamicDepthChains("nil tail", nil))
	checkDepthChains(t, dynamicDepthChains("empty tail", []any{}))
}

func tagChain(name string, tags []int, limit int) depthChain {
	return depthChain{name, limit, func(n int) (outcome, outcome) {
		g, m := deepTags(n, tags)
		return outcomeOf(g.MarshalJSON()), outcomeOf(json.Marshal(m))
	}}
}

func TestStaticEncoderDepthCountsScalarSlices(t *testing.T) {
	checkDepthChains(t, []depthChain{
		tagChain("nil tags", nil, 9999),
		tagChain("empty tags", []int{}, 9999),
		tagChain("one tag", []int{1}, 9998),
	})
}

type OptStamp int64

func (s OptStamp) MarshalJSON() ([]byte, error) {
	return json.Marshal(int64(s) * 10)
}

type OptWire struct {
	OS  ([]int64)?              `json:"os"`
	OM  (map[string]int64)?     `json:"om"`
	OA  ([2]string)?            `json:"oa"`
	SO  [](int64?)              `json:"so"`
	MO  map[string](int64?)     `json:"mo"`
	AO  [2](string?)            `json:"ao"`
	OSP ([](*int64?))?          `json:"osp"`
	SOS [](([]int64)?)          `json:"sos"`
	OSS ([][]int64)?            `json:"oss"`
	SSO [][](int64?)            `json:"sso"`
	MOS map[string](([]int64)?) `json:"mos"`
	OMS (map[string][]int64)?   `json:"oms"`
	MSO map[string][](int64?)   `json:"mso"`
	O   int?                    `json:"o"`
	ST  [](OptStamp?)           `json:"st"`
}

type optWireMirror OptWire

func TestStaticEncoderOptionComposites(t *testing.T) {
	seven := int64(7)
	cases := []struct {
		name string
		w    OptWire
	}{
		{"absent options", OptWire{}},
		{"present empty payloads", OptWire{
			OS: []int64{}, OM: map[string]int64{}, OA: [2]string{}, SO: [](int64?){}, MO: map[string](int64?){},
			OSP: [](*int64?){}, SOS: [](([]int64)?){}, OSS: [][]int64{}, SSO: [][](int64?){},
			MOS: map[string](([]int64)?){}, OMS: map[string][]int64{}, MSO: map[string][](int64?){}, ST: [](OptStamp?){},
		}},
		{"present nil payloads", OptWire{OS: []int64(nil), OM: map[string]int64(nil), OSP: [](*int64?)(nil), OSS: [][]int64(nil), OMS: map[string][]int64(nil)}},
		{"every option present", OptWire{
			OS:  []int64{1, 2},
			OM:  map[string]int64{"y": 1, "x": 2},
			OA:  [2]string{"p", "q"},
			SO:  [](int64?){7, nil},
			MO:  map[string](int64?){"b": 2, "a": nil, "c": 3},
			AO:  [2](string?){"p", nil},
			OSP: [](*int64?){&seven, nil},
			SOS: [](([]int64)?){[]int64{1}, nil, []int64{}},
			OSS: [][]int64{{1, 2}, nil},
			SSO: [][](int64?){{3, nil}, nil},
			MOS: map[string](([]int64)?){"k": []int64{4}, "n": nil},
			OMS: map[string][]int64{"k": {5}, "n": nil},
			MSO: map[string][](int64?){"k": {6, nil}},
			O:   9,
			ST:  [](OptStamp?){OptStamp(3), nil},
		}},
	}
	for _, c := range cases {
		sameOutcome(t, c.name, outcomeOf(c.w.MarshalJSON()), outcomeOf(json.Marshal(optWireMirror(c.w))))
	}
}

type NumQuoteRoot struct {
	P *json.Number `json:"p,string"`
	O *QuotedObj   `json:"o,string"`
}

type numQuoteRootMirror NumQuoteRoot

func TestStaticEncoderEdgeStringOption(t *testing.T) {
	seven, obj := json.Number("7"), QuotedObj(1)
	r := NumQuoteRoot{P: &seven, O: &obj}
	got := sameOutcome(t, "edge string option", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(numQuoteRootMirror(r))))
	if string(got) != `{"p":"7","o":{"k":1}}` {
		t.Fatalf("edge string option: got %s", got)
	}
}
