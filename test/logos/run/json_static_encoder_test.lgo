type QBox struct {
	O     QuotedObj       `json:"o,string"`
	SO    QuotedStringObj `json:"so,string"`
	T     QuotedText      `json:"t,string"`
	PJ    PtrJSON         `json:"pj,string"`
	PT    PtrText         `json:"pt,string"`
	B     BothT           `json:"b,string"`
	NO    *QuotedObj?     `json:"no,string"`
	NP    *int?           `json:"np,string"`
	NoGen any             `json:"-"`
}

type QRoot struct {
	Val QBox            `json:"val"`
	Ptr *QBox?          `json:"ptr"`
	Map map[string]QBox `json:"map"`
}

type qRootMirror QRoot

func TestStaticEncoderQuotedMethodPrecedence(t *testing.T) {
	obj := QuotedObj(9)
	p := 123
	v := QBox{O: 42, SO: "hello", T: "plain", PJ: 53, PT: 53, B: 13}
	full := v
	full.NO = &obj
	full.NP = &p
	for i, r := range []QRoot{{Val: v, Ptr: &v, Map: map[string]QBox{"k": v}}, {Val: full, Ptr: &full}} {
		sameOutcome(t, "quoted precedence "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(qRootMirror(r))))
	}
}

type IZInt int

func (v IZInt) IsZero() bool { return v == 42 }

type IZString string

func (v IZString) IsZero() bool { return v == "zero" }

type IZBool bool

func (v IZBool) IsZero() bool { return bool(v) }

type IZPtrRecv int

func (v *IZPtrRecv) IsZero() bool { return *v == 7 }

type IZPlusJSON int

func (v IZPlusJSON) IsZero() bool { return v == 0 }

func (v IZPlusJSON) MarshalJSON() ([]byte, error) { return []byte(`"custom"`), nil }

type IZBox struct {
	IS    IZInt      `json:"is,string"`
	SS    IZString   `json:"ss,string"`
	BS    IZBool     `json:"bs,string"`
	IO    IZInt      `json:"io,omitzero"`
	SO    IZString   `json:"so,omitzero"`
	BO    IZBool     `json:"bo,omitzero"`
	PO    IZPtrRecv  `json:"po,omitzero"`
	ISO   IZInt      `json:"iso,string,omitzero"`
	SSO   IZString   `json:"sso,string,omitzero"`
	BSO   IZBool     `json:"bso,string,omitzero"`
