type izTopMirror IZTop

type MutIZInt int

func (v *MutIZInt) IsZero() bool {
	*v = 99
	return false
}

type Set99 struct {
	N     int `json:"n"`
	NoGen any `json:"-"`
}

func (z *Set99) IsZero() bool {
	z.N = 99
	return false
}

type MutIZRoot struct {
	S MutIZInt `json:"s,omitzero"`
	P *Set99?  `json:"p,omitzero"`
}

type mutIZRootMirror MutIZRoot

type MutStructIZRoot struct {
	S Set99 `json:"s,omitzero"`
}

type mutStructIZRootMirror MutStructIZRoot

type MutAnyRoot struct {
	Any []any `json:"any"`
}

type mutAnyRootMirror MutAnyRoot

func TestStaticEncoderIsZero(t *testing.T) {
	zero := IZBox{IS: 42, SS: "zero", BS: true, IO: 42, SO: "zero", BO: true, PO: 7, ISO: 42, SSO: "zero", BSO: true, JO: 0}
	kept := IZBox{IS: 53, SS: "hi", BS: false, IO: 0, SO: "", BO: false, PO: 0, ISO: 0, SSO: "hi", BSO: false, JS: 53, JO: 53}
	roots := []IZTop{
		{IO: 42, SO: "zero", BO: true, PO: 7, ISO: 42, JO: 0, EZ: 42, Box: zero, Ptr: &zero},
		{IO: 0, SO: "", BO: false, PO: 0, ISO: 0, JO: 53, EZ: 0, Box: kept, Ptr: &kept},
		{EZ: 5},
	}
	for i, r := range roots {
		sameOutcome(t, "iszero "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(izTopMirror(r))))
	}
	t.Run("mutating iszero static value", func(t *testing.T) {
		gv, sv := MutIZRoot{S: 1}, MutIZRoot{S: 1}
		sameOutcome(t, "mutating iszero static value", outcomeOf(gv.MarshalJSON()), outcomeOf(json.Marshal(mutIZRootMirror(sv))))
	})
	t.Run("mutating iszero pointer", func(t *testing.T) {
		gp, sp := &Set99{N: 1}, &Set99{N: 1}
		gr, sr := MutIZRoot{S: 99, P: gp}, MutIZRoot{S: 99, P: sp}
		sameOutcome(t, "mutating iszero pointer", outcomeOf(gr.MarshalJSON()), outcomeOf(json.Marshal(mutIZRootMirror(sr))))
		if gp.N != 99 || sp.N != 99 {
			t.Fatalf("mutating iszero pointer control: generated post-state %d, encoding/json post-state %d, want 99", gp.N, sp.N)
		}
	})
	t.Run("mutating iszero fallback value", func(t *testing.T) {
		type zeroBox struct {
			Z Set99 `json:"z,omitzero"`
		}
		gf, sf := MutAnyRoot{Any: []any{zeroBox{Z: Set99{N: 1}}}}, MutAnyRoot{Any: []any{zeroBox{Z: Set99{N: 1}}}}
		sameOutcome(t, "mutating iszero fallback value", outcomeOf(gf.MarshalJSON()), outcomeOf(json.Marshal(mutAnyRootMirror(sf))))
	})
	t.Run("mutating iszero fallback pointer", func(t *testing.T) {
		type zeroBox struct {
			Z Set99 `json:"z,omitzero"`
		}
		gpa, spa := &zeroBox{Z: Set99{N: 1}}, &zeroBox{Z: Set99{N: 1}}
		gfp, sfp := MutAnyRoot{Any: []any{gpa}}, MutAnyRoot{Any: []any{spa}}
		sameOutcome(t, "mutating iszero fallback pointer", outcomeOf(gfp.MarshalJSON()), outcomeOf(json.Marshal(mutAnyRootMirror(sfp))))
		if gpa.Z.N != 99 || spa.Z.N != 99 {
			t.Fatalf("mutating iszero fallback pointer control: generated post-state %d, encoding/json post-state %d, want 99", gpa.Z.N, spa.Z.N)
		}
	})
	t.Run("mutating iszero fallback slice", func(t *testing.T) {
		type zeroBox struct {
			Z Set99 `json:"z,omitzero"`
		}
		gsl, ssl := []zeroBox{{Z: Set99{N: 1}}}, []zeroBox{{Z: Set99{N: 1}}}
		gfs, sfs := MutAnyRoot{Any: []any{gsl}}, MutAnyRoot{Any: []any{ssl}}
		sameOutcome(t, "mutating iszero fallback slice", outcomeOf(gfs.MarshalJSON()), outcomeOf(json.Marshal(mutAnyRootMirror(sfs))))
		if gsl[0].Z.N != 99 || ssl[0].Z.N != 99 {
			t.Fatalf("mutating iszero fallback slice control: generated post-state %d, encoding/json post-state %d, want 99", gsl[0].Z.N, ssl[0].Z.N)
		}
	})
	t.Run("mutating iszero static struct", func(t *testing.T) {
		gv, sv := MutStructIZRoot{S: Set99{N: 1}}, MutStructIZRoot{S: Set99{N: 1}}
		sameOutcome(t, "mutating iszero static struct", outcomeOf(gv.MarshalJSON()), outcomeOf(json.Marshal(mutStructIZRootMirror(sv))))
	})
}

type ZeroVal struct {
	N     int `json:"n"`
	NoGen any `json:"-"`
}

func (z ZeroVal) IsZero() bool { return z.N == 7 }

type ZeroPtr struct {
	N     int `json:"n"`
	NoGen any `json:"-"`
}

func (z *ZeroPtr) IsZero() bool { return z.N == 7 }

type Zeroer interface {
	IsZero() bool
}

type NamedSlice []int

func (s NamedSlice) IsZero() bool { return len(s) == 3 }

type PlainS struct {
	A int
	B string
}

type NonComp struct {
	S []int
	M map[string]int
	P PlainS
}

type EmptyBox struct {
	I     int            `json:"i,omitempty"`
	I8    int8           `json:"i8,omitempty"`
	U16   uint16         `json:"u16,omitempty"`
	Up    uintptr        `json:"up,omitempty"`
	S     string         `json:"s,omitempty"`
	B     bool           `json:"b,omitempty"`
	F     float64        `json:"f,omitempty"`
	F32   float32        `json:"f32,omitempty"`
	Sl    []int          `json:"sl,omitempty"`
	M     map[string]int `json:"m,omitempty"`
	A0    [0]int         `json:"a0,omitempty"`
	A2    [2]int         `json:"a2,omitempty"`
	P     *int?          `json:"p,omitempty"`
	St    PlainS         `json:"st,omitempty"`
	T     time.Time      `json:"t,omitempty"`
	Any   any            `json:"any,omitempty"`
	NS    NamedSlice     `json:"ns,omitempty"`
	NoGen any            `json:"-"`
}

type ZeroBox struct {
	I     int            `json:"i,omitzero"`
	S     string         `json:"s,omitzero"`
	F     float64        `json:"f,omitzero"`
	B     bool           `json:"b,omitzero"`
	Sl    []int          `json:"sl,omitzero"`
	A2    [2]int         `json:"a2,omitzero"`
	AS    [2][]int       `json:"as,omitzero"`
	St    PlainS         `json:"st,omitzero"`
	NC    NonComp        `json:"nc,omitzero"`
	T     time.Time      `json:"t,omitzero"`
	ZV    ZeroVal        `json:"zv,omitzero"`
	ZP    ZeroPtr        `json:"zp,omitzero"`
	PZP   *ZeroPtr?      `json:"pzp,omitzero"`
	PZV   *ZeroVal?      `json:"pzv,omitzero"`
	NS    NamedSlice     `json:"ns,omitzero"`
	Z     Zeroer         `json:"z,omitzero"`
	Big   big.Int        `json:"big,omitzero"`
	NoGen any            `json:"-"`
}

type OmitRoot struct {
	E   EmptyBox     `json:"e"`
	Z   ZeroBox      `json:"z"`
	PE  *EmptyBox?   `json:"pe"`
	PZ  *ZeroBox?    `json:"pz"`
	T   time.Time    `json:"t,omitzero"`
	A   [2]int       `json:"a,omitzero"`
	St  PlainS       `json:"st,omitzero"`
	NC  NonComp      `json:"nc,omitzero"`
	NS  NamedSlice   `json:"ns,omitzero"`
	NSE NamedSlice   `json:"nse,omitempty"`
	Big big.Int      `json:"big,omitzero"`
	M   map[string]int `json:"m,omitempty,omitzero"`
}

type omitRootMirror OmitRoot

func TestStaticEncoderOmitParity(t *testing.T) {
	one := 1
	full := EmptyBox{I: 5, I8: -1, U16: 3, Up: 1, S: "x", B: true, F: 1.5, F32: 1.5, Sl: []int{1}, M: map[string]int{"a": 1}, P: &one, St: PlainS{A: 1}, T: time.Unix(1, 0).UTC(), Any: 0, NS: NamedSlice{1, 2, 3}}
	empties := EmptyBox{Sl: []int{}, M: map[string]int{}, NS: NamedSlice{}}
	zeroes := ZeroBox{ZV: ZeroVal{N: 7}, ZP: ZeroPtr{N: 7}, PZP: &ZeroPtr{N: 7}, PZV: &ZeroVal{N: 7}, NS: NamedSlice{1, 2, 3}, Z: ZeroVal{N: 7}}
	kept := ZeroBox{I: 1, S: "x", F: -1, B: true, Sl: []int{}, A2: [2]int{0, 1}, AS: [2][]int{nil, {}}, St: PlainS{B: "x"}, NC: NonComp{M: map[string]int{}}, T: time.Unix(1, 0).UTC(), ZV: ZeroVal{N: 1}, ZP: ZeroPtr{N: 1}, PZP: &ZeroPtr{N: 1}, PZV: &ZeroVal{N: 1}, NS: NamedSlice{}, Z: &ZeroPtr{N: 1}}
	kept.Big = *big.NewInt(5)
	ptrZero := ZeroBox{Z: &ZeroPtr{N: 7}}
	roots := []OmitRoot{
		{},
		{E: full, Z: kept, PE: &full, PZ: &kept, T: time.Unix(2, 0).UTC(), A: [2]int{1, 0}, St: PlainS{A: 2}, NC: NonComp{S: []int{}}, NS: NamedSlice{1}, NSE: NamedSlice{1}, M: map[string]int{}},
		{E: empties, Z: zeroes, PE: &empties, PZ: &zeroes, NS: NamedSlice{4, 5, 6}, NSE: NamedSlice{}, M: map[string]int{"a": 1}},
		{Z: ptrZero, PZ: &ptrZero},
	}
	roots[1].Big = *big.NewInt(-3)
	for i, r := range roots {
		sameOutcome(t, "omit "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(omitRootMirror(r))))
	}
}

