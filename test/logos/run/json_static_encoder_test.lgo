// run

package jsonstaticenc

import (
	"encoding"
	"encoding/json"
	"errors"
	"math"
	"math/big"
	"reflect"
	"strings"
	"testing"
	"time"
)

type outcome struct {
	b   []byte
	err error
}

func outcomeOf(b []byte, err error) outcome {
	return outcome{b, err}
}

func sameOutcome(t *testing.T, label string, gen, std outcome) []byte {
	t.Helper()
	if (gen.err == nil) != (std.err == nil) {
		t.Fatalf("%s: generated error %v, encoding/json error %v", label, gen.err, std.err)
	}
	if gen.err != nil {
		if gen.err.Error() != std.err.Error() {
			t.Fatalf("%s: generated error %q, encoding/json error %q", label, gen.err.Error(), std.err.Error())
		}
		if reflect.TypeOf(gen.err) != reflect.TypeOf(std.err) {
			t.Fatalf("%s: generated error type %T, encoding/json error type %T", label, gen.err, std.err)
		}
		return nil
	}
	if string(gen.b) != string(std.b) {
		t.Fatalf("%s: generated %s, encoding/json %s", label, gen.b, std.b)
	}
	return gen.b
}

func sameDepthOutcome(t *testing.T, label string, gen, std outcome) {
	t.Helper()
	sameOutcome(t, label, gen, std)
	gs, gok := gen.err.(*json.SyntaxError)
	ws, wok := std.err.(*json.SyntaxError)
	if gok && wok && gs.Offset != ws.Offset {
		t.Fatalf("%s: generated offset %d, encoding/json offset %d", label, gs.Offset, ws.Offset)
	}
}

func sameErrorKind(t *testing.T, label string, gerr, werr error) {
	t.Helper()
	if gerr == nil || werr == nil {
		t.Fatalf("%s: generated error %v, encoding/json error %v, want both", label, gerr, werr)
	}
	if reflect.TypeOf(gerr) != reflect.TypeOf(werr) {
		t.Fatalf("%s: generated error type %T, encoding/json error type %T", label, gerr, werr)
	}
}

func safeMarshalOutcome(f func() ([]byte, error)) (out outcome, panicked any) {
	defer func() {
		if p := recover(); p != nil {
			panicked = p
		}
	}()
	out = outcomeOf(f())
	return
}

type Embed struct {
	E     string `json:"e"`
	NoGen any    `json:"-"`
}

type Outer struct {
	Embed
	Name   string `json:"name"`
	Skip   int    `json:"-"`
	Omit   []int  `json:"omit,omitempty"`
	Zero   string `json:"zero,omitzero"`
	QS     int    `json:"qs,string"`
	HTML   string `json:"html"`
	hidden string
}

type TextT struct {
	V     int `json:"v"`
	NoGen any `json:"-"`
}

func (TextT) MarshalText() ([]byte, error) {
	return []byte("text"), nil
}

type UserT struct {
	V     int `json:"v"`
	NoGen any `json:"-"`
}

func (UserT) MarshalJSON() ([]byte, error) {
	return []byte(`"user"`), nil
}

type Mixed struct {
	A    int       `json:"a,string"`
	B    bool      `json:"b,string"`
	S    string    `json:"s,string"`
	F    float64   `json:"f,string"`
	M    TextT     `json:"m"`
	U    UserT     `json:"u"`
	T    time.Time `json:"t"`
	P    *int?     `json:"p"`
	Any  any       `json:"any"`
	Arr  [2]int    `json:"arr"`
	Html string    `json:"html"`
}

type SweepRoot struct {
	Vals  []any             `json:"vals"`
	Bytes []byte            `json:"bytes"`
	Ints  [][]int           `json:"ints"`
	Maps  []map[int]string  `json:"maps"`
	Uints []map[uint8]bool  `json:"uints"`
	Outer []Outer           `json:"outer"`
	Mixed Mixed             `json:"mixed"`
	Arr   [2]map[string]int `json:"arr"`
	Nil   map[string]any    `json:"nil"`
	Empty map[string]any    `json:"empty"`
	SM    map[string]int    `json:"sm"`
	Users []UserT           `json:"users"`
	Texts map[string]TextT  `json:"texts"`
}

type sweepRootMirror SweepRoot

func TestStaticEncoderParitySweep(t *testing.T) {
	ts := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
	roots := []SweepRoot{
		{},
		{
			Vals:  []any{nil, true, -42, uint64(1 << 63), 2.5, "a<b>&\u2028\"q\"\\", []byte("bytes"), []int{3, 1, 2}, []any{"s", 1.5, true, nil}, []string{}, map[string]int{"b": 2, "a": 1}},
			Bytes: []byte("bytes<&>"),
			Ints:  [][]int{{3, 1, 2}, nil, {}},
			Maps:  []map[int]string{{10: "j", 2: "b", -1: "m"}, nil},
			Uints: []map[uint8]bool{{200: true, 3: false}},
			Outer: []Outer{
				{E: "e", Name: "n", Zero: "", QS: 7, HTML: "<>&"},
				{E: "e", Name: "n", Omit: []int{1}, Zero: "z", HTML: "x"},
			},
			Mixed: Mixed{A: 1, B: true, S: "s<&>", F: 0.5, M: TextT{V: 1}, U: UserT{V: 2}, T: ts, Any: []int{9}, Html: "a<b>&\u2029"},
			Arr:   [2]map[string]int{{"a": 1}, nil},
			Empty: map[string]any{},
			SM:    map[string]int{"z": 26, "<a>": 1},
			Users: []UserT{{V: 1}},
			Texts: map[string]TextT{"k": {V: 3}},
		},
	}
	for i, r := range roots {
		sameOutcome(t, "sweep "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(sweepRootMirror(r))))
	}
}

type StringOpts struct {
	I     int      `json:"i,string"`
	PI    *int?    `json:"pi,string"`
	NI    *int?    `json:"ni,string"`
	U     uint64   `json:"u,string"`
	S     string   `json:"s,string"`
	PS    *string? `json:"ps,string"`
	B     bool     `json:"b,string"`
	F     float64  `json:"f,string"`
	F32   float32  `json:"f32,string"`
	NoGen any      `json:"-"`
}

type StringRoot struct {
	Val StringOpts            `json:"val"`
	Ptr *StringOpts?          `json:"ptr"`
	Map map[string]StringOpts `json:"map"`
	Any []any                 `json:"any"`
}

type stringRootMirror StringRoot

func TestStaticEncoderStringOption(t *testing.T) {
	i := 42
	str := "a<b>&\"\\"
	v := StringOpts{I: 42, PI: &i, U: 1 << 63, S: str, PS: &str, B: true, F: 0.5, F32: 1e21}
	r := StringRoot{Val: v, Ptr: &v, Map: map[string]StringOpts{"k": v}, Any: []any{map[string]any{"k": []any{"x&y", ""}}}}
	sameOutcome(t, "string option", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(stringRootMirror(r))))
}

type Link struct {
	Name  string `json:"name"`
	Next  *Link? `json:"next,omitempty"`
	NoGen any    `json:"-"`
}

type LinkList [](*Link?)

type LinkRoot struct {
	Head *Link?   `json:"head"`
	L    *Link?   `json:"l"`
	R    *Link?   `json:"r"`
	Arr  LinkList `json:"arr"`
}

type linkRootMirror LinkRoot

type AnyRoot struct {
	M  map[string]any `json:"m"`
	Xs []any          `json:"xs"`
}

type anyRootMirror AnyRoot

func cyclePrefix() string {
	return "json: unsupported value: encountered a cycle via "
}

func sameCycle(t *testing.T, label string, gerr, werr error) {
	t.Helper()
	sameErrorKind(t, label, gerr, werr)
	for _, err := range []error{gerr, werr} {
		if !strings.HasPrefix(err.Error(), cyclePrefix()) {
			t.Fatalf("%s: error %q, want the encoding/json cycle error", label, err.Error())
		}
	}
	if _, ok := gerr.(*json.UnsupportedValueError); !ok {
		t.Fatalf("%s: error type %T, want *json.UnsupportedValueError", label, gerr)
	}
}

func TestStaticEncoderCycleTerminates(t *testing.T) {
	n := &Link{Name: "a"}
	n.Next = n
	_, gerr := LinkRoot{Head: n}.MarshalJSON()
	_, werr := json.Marshal(linkRootMirror(LinkRoot{Head: n}))
	sameCycle(t, "pointer cycle", gerr, werr)
	inner := map[string]any{"self": nil}
	m := map[string]any{"n": inner}
	inner["self"] = m
	_, gerr = AnyRoot{M: m}.MarshalJSON()
	_, werr = json.Marshal(anyRootMirror(AnyRoot{M: m}))
	sameCycle(t, "map cycle", gerr, werr)
	xs := []any{nil}
	xs[0] = xs
	_, gerr = AnyRoot{Xs: xs}.MarshalJSON()
	_, werr = json.Marshal(anyRootMirror(AnyRoot{Xs: xs}))
	sameCycle(t, "slice cycle", gerr, werr)
}

func TestStaticEncoderDAGIsNotACycle(t *testing.T) {
	shared := &Link{Name: "s"}
	r := LinkRoot{L: &Link{Name: "l", Next: shared}, R: &Link{Name: "r", Next: shared}, Arr: LinkList{shared, shared, nil}}
	got := sameOutcome(t, "dag", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(linkRootMirror(r))))
	if strings.Count(string(got), `"s"`) != 4 {
		t.Fatalf("shared tail not encoded at every reference: %s", got)
	}
}

func buildLinks(n int) *Link {
	head := &Link{Name: "h"}
	cur := head
	for range n {
		next := &Link{Name: "n"}
		cur.Next = next
		cur = next
	}
	return head
}

func TestStaticEncoderDeepNestingMatchesCap(t *testing.T) {
	for _, n := range []int{3000, 9000, 20000} {
		r := LinkRoot{Head: buildLinks(n)}
		sameDepthOutcome(t, "deep chain", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(linkRootMirror(r))))
	}
}

type BothT int

func (BothT) MarshalText() ([]byte, error) {
	return []byte("text"), nil
}

func (*BothT) MarshalJSON() ([]byte, error) {
	return []byte(`"ptr"`), nil
}

type BothBox struct {
	B     BothT `json:"b"`
	NoGen any   `json:"-"`
}

type BothRoot struct {
	Val   BothBox          `json:"val"`
	Ptr   *BothBox?        `json:"ptr"`
	Slice []BothT          `json:"slice"`
	Map   map[string]BothT `json:"map"`
	Arr   [1]BothT         `json:"arr"`
	PArr  *[1]BothT?       `json:"parr"`
	Boxes []BothBox        `json:"boxes"`
	Any   []any            `json:"any"`
}

type bothRootMirror BothRoot

func TestStaticEncoderAddressabilityPrecedence(t *testing.T) {
	arr := [1]BothT{2}
	r := BothRoot{
		Val:   BothBox{B: 3},
		Ptr:   &BothBox{B: 4},
		Slice: []BothT{5},
		Map:   map[string]BothT{"k": 6},
		Arr:   [1]BothT{7},
		PArr:  &arr,
		Boxes: []BothBox{{B: 8}},
		Any:   []any{BothT(9)},
	}
	got := sameOutcome(t, "addressability", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(bothRootMirror(r))))
	const body = `{"val":{"b":"text"},"ptr":{"b":"ptr"},"slice":["ptr"],"map":{"k":"text"},"arr":["text"],"parr":["ptr"],"boxes":[{"b":"ptr"}],"any":["text"]}`
	if string(got) != body {
		t.Fatalf("addressability precedence: got %s, want %s", got, body)
	}
}

type GenItem struct {
	Name string `json:"name"`
	Kids []any  `json:"kids,omitempty"`
}

type DynRoot struct {
	Items []GenItem `json:"items"`
	Xs    []any     `json:"xs"`
}

type dynRootMirror DynRoot

func TestStaticEncoderDynamicDispatch(t *testing.T) {
	g := GenItem{Name: "g"}
	r := DynRoot{
		Items: []GenItem{{Name: "a", Kids: []any{"k"}}},
		Xs:    []any{g, &g, UserT{V: 1}, TextT{V: 2}, json.Number("12"), "s", 1.5, nil},
	}
	sameOutcome(t, "dynamic dispatch", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(dynRootMirror(r))))
	var gerr error
	cyc := &GenItem{Name: "c"}
	cyc.Kids = []any{cyc}
	_, gerr = DynRoot{Xs: []any{cyc}}.MarshalJSON()
	if gerr == nil || !strings.HasPrefix(gerr.Error(), cyclePrefix()) {
		t.Fatalf("cycle through an interface value = %v, want the encoding/json cycle error", gerr)
	}
}

type DiaA struct {
	X     int `json:"x"`
	NoGen any `json:"-"`
}

type DiaB struct {
	DiaA
}

type DiaC struct {
	DiaA
}

type DiaD struct {
	DiaB
	DiaC
	Y int `json:"y"`
}

type DiaTagged struct {
	DiaB
	X int `json:"x"`
}

type EmbPtr struct {
	*DiaA
	Z int `json:"z"`
}

type DiamondRoot struct {
	D DiaD      `json:"d"`
	T DiaTagged `json:"t"`
	P []EmbPtr  `json:"p"`
}

type diamondRootMirror DiamondRoot

func TestStaticEncoderEmbeddedFields(t *testing.T) {
	r := DiamondRoot{
		D: DiaD{DiaB: DiaB{DiaA{X: 1}}, DiaC: DiaC{DiaA{X: 2}}, Y: 3},
		T: DiaTagged{DiaB: DiaB{DiaA{X: 4}}, X: 5},
		P: []EmbPtr{{DiaA: &DiaA{X: 6}, Z: 6}, {DiaA: &DiaA{X: 7}, Z: 8}},
	}
	sameOutcome(t, "embedded", outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(diamondRootMirror(r))))
}

type BadKey struct {
	A int
}

type UnsupBox struct {
	F     []func()          `json:"f"`
	M     []map[bool]int    `json:"m"`
	C     []complex128      `json:"c"`
	K     []map[BadKey]int  `json:"k"`
	Ch    []chan int        `json:"ch"`
	NoGen any               `json:"-"`
}

type UnsupRoot struct {
	B UnsupBox `json:"b"`
}

type unsupRootMirror UnsupRoot

func TestStaticEncoderUnsupportedKinds(t *testing.T) {
	cases := []UnsupBox{
		{},
		{F: []func(){func() {}}},
		{M: []map[bool]int{nil}},
		{C: []complex128{complex(1, 2)}},
		{K: []map[BadKey]int{nil}},
		{Ch: []chan int{make(chan int)}},
		{F: []func(){}, C: []complex128{}},
	}
	for i, c := range cases {
		sameOutcome(t, "unsupported "+string(rune('0'+i)), outcomeOf(UnsupRoot{B: c}.MarshalJSON()), outcomeOf(json.Marshal(unsupRootMirror(UnsupRoot{B: c}))))
	}
}

type unsupKeyCase struct {
	box UnsupBox
	key any
}

func TestStaticEncoderUnsupportedMapKeys(t *testing.T) {
	boolKeys := map[bool]int{true: 1}
	structKeys := map[BadKey]int{BadKey{1}: 1}
	for _, c := range []unsupKeyCase{{UnsupBox{M: []map[bool]int{boolKeys}}, boolKeys}, {UnsupBox{K: []map[BadKey]int{structKeys}}, structKeys}} {
		_, gerr := UnsupRoot{B: c.box}.MarshalJSON()
		_, werr := json.Marshal(unsupRootMirror(UnsupRoot{B: c.box}))
		_, direct := json.Marshal(c.key)
		sameErrorKind(t, "unsupported map key", gerr, werr)
		if gerr.Error() != direct.Error() {
			t.Fatalf("unsupported map key: generated error %q, encoding/json error for the map %q", gerr.Error(), direct.Error())
		}
	}
}

type NumberAlias = json.Number

type DefinedNumber json.Number

type DefinedString string

type NumBox struct {
	N     json.Number   `json:"n"`
	P     *json.Number? `json:"p"`
	A     NumberAlias   `json:"a"`
	D     DefinedNumber `json:"d"`
	S     DefinedString `json:"s"`
	NQ    json.Number   `json:"nq,string"`
	PQ    *json.Number? `json:"pq,string"`
	AQ    NumberAlias   `json:"aq,string"`
	DQ    DefinedNumber `json:"dq,string"`
	SQ    DefinedString `json:"sq,string"`
	NoGen any           `json:"-"`
}

type NumRoot struct {
	Ns   []json.Number            `json:"ns"`
	Box  NumBox                   `json:"box"`
	Map  map[string]json.Number   `json:"map"`
	Any  []any                    `json:"any"`
	Nest map[string][]json.Number `json:"nest"`
}

type numRootMirror NumRoot

func TestStaticEncoderNumber(t *testing.T) {
	seven := json.Number("7")
	empty := json.Number("")
	roots := []NumRoot{
		{Ns: []json.Number{"123", "-0", "1E+2", "0.5e-3", ""}},
		{Box: NumBox{N: "123", P: &seven, A: "99", D: "123", S: "123", NQ: "123", PQ: &seven, AQ: "99", DQ: "abc", SQ: "abc"}},
		{Box: NumBox{N: "", P: nil, A: "", D: "", S: "", NQ: "", PQ: &empty, AQ: "", DQ: "", SQ: ""}},
		{Map: map[string]json.Number{"a": "7", "zero": ""}, Any: []any{json.Number("42"), map[string]any{"num": json.Number("2")}}},
		{Nest: map[string][]json.Number{"k": {"10", ""}}},
	}
	for i, r := range roots {
		sameOutcome(t, "number "+string(rune('0'+i)), outcomeOf(r.MarshalJSON()), outcomeOf(json.Marshal(numRootMirror(r))))
	}
}

func TestStaticEncoderInvalidNumber(t *testing.T) {
	for _, bad := range []string{"-", "01", "1e", "1x", "+1", ".5", "1.", "NaN", " 1", "abc"} {
		num := json.Number(bad)
		_, direct := json.Marshal(num)
		roots := []NumRoot{
			{Ns: []json.Number{num}},
			{Any: []any{num}},
			{Map: map[string]json.Number{"bad": num}},
			{Box: NumBox{N: num}},
			{Box: NumBox{NQ: num}},
			{Box: NumBox{PQ: &num}},
		}
		for _, r := range roots {
			_, gerr := r.MarshalJSON()
			_, werr := json.Marshal(numRootMirror(r))
			sameErrorKind(t, "invalid "+bad, gerr, werr)
			if gerr.Error() != direct.Error() {
				t.Fatalf("invalid %q: generated error %q, encoding/json number error %q", bad, gerr.Error(), direct.Error())
			}
		}
	}
}

type QuotedObj int

