const bigLen = len(big)

func main() {
	fmt.Println(one["only"] ?? -1, one["nope"] ?? -1)
	for k := 1; k <= 8; k++ {
		fmt.Print(eight[k] ?? "-")
	}
	fmt.Println()
	fmt.Println(eight[0] ?? "none", eight[9] ?? "none")
	for k := 1; k <= 9; k++ {
		fmt.Print(nine[k] ?? "-")
	}
	fmt.Println()
	fmt.Println(nine[10] ?? "none")
	hits := 0
	for i := 0; i < 10000; i++ {
		if (big[fmt.Sprintf("k%05d", i)] ?? -1) == i*3 {
			hits++
		}
	}
	fmt.Println(hits)
	fmt.Println(big["k10000"] ?? -1, big["k0"] ?? -1)
	for k, v := range nine {
		fmt.Printf("%d%s,", k, v)
	}
	fmt.Println()
	n, sorted, prev := 0, true, ""
	for k := range big {
		if n > 0 && k <= prev {
			sorted = false
		}
		prev = k
		n++
	}
	fmt.Println(n, sorted)
	fmt.Println(bigLen, len(big), len(nine), len(one))
	var m1 map[int]string = nine
	var m2 map[int]string = nine
	fmt.Println(len(m1), m1[3], fmt.Sprintf("%p", m1) == fmt.Sprintf("%p", m2))
	count := 0
	for range maps.Keys(nine) {
		count++
	}
	fmt.Println(count)
}
