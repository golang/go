type Dur int64
type Tick uint64
type Ratio float64
type Gain float32

type I64K struct {
	S     []int64     `json:"s"`
	A0    [0]int64    `json:"a0"`
	A1    [1]int64    `json:"a1"`
	A7    [7]int64    `json:"a7"`
	A8    [8]int64    `json:"a8"`
	A9    [9]int64    `json:"a9"`
	A1000 [1000]int64 `json:"a1000"`
}

