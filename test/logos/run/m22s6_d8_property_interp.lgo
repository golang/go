// run

package main

import "fmt"

// M22-S6 defect D8 (SPEC T-104.4, T-203.2): a property read through an
// interface lowers inside `$"..."` braces like any other read.

type A interface {
	const ID int64
	const Name string
}

type R struct : A {
	ID   int64
	Name string
}

func audit(a A) string {
	return $"{a.ID} {a.Name}"
}

func main() {
	fmt.Println(audit(&R{ID: 1, Name: "n"}))
}
