// run -goexperiment simd -godebug cpu.avx=off,cpu.avx2=off,cpu.avx512f=off -goamd64=v1

package main

import (
	"fmt"
	"os"
	"strings"
)

// M14-S2 attack (SPEC Sec 2.4, T-204.2): on amd64 the vector form sits
// behind an archsimd CPU feature guard, so a runtime with the feature
// disabled via GODEBUG takes the scalar branch and every operator and
// reduction still matches the scalar oracle. The guard is elided only
// when the build's GOAMD64 level guarantees the feature (v3: AVX and
// AVX2; v4: AVX512), so the directive pins GOAMD64=v1, because the logos
// default target is v3 (M13-S1, SPEC #107). The
// directive above turns all three features off; checkSeam proves it
// reached this process, and simd_cpu_seam.go proves the runtime then
// reports each feature as absent, so the vector branch cannot run
// unnoticed. This file stays free of simd/archsimd so the unit tests
// that lower every run fixture without the experiment still check it.
// The scalar branch is forced only at GOAMD64 v1 or v2: from v3 the
// compiler drops the AVX and AVX2 checks and the cpu.avx and cpu.avx2
// knobs no longer exist, so a v3 run takes the vector path and says
// nothing about the guard.

func checkSeam() {
	for _, off := range []string{"cpu.avx=off", "cpu.avx2=off", "cpu.avx512f=off"} {
		if !strings.Contains(os.Getenv("GODEBUG"), off) {
			panic("GODEBUG is missing " + off + ": the harness directive did not reach this process")
		}
	}
}

func oracleAdd4(a, b [4]float64) [4]float64 {
	var r [4]float64
	for i := range r {
		r[i] = a[i] + b[i]
	}
	return r
}

func oracleMul8(a, b [8]float32) [8]float32 {
	var r [8]float32
	for i := range r {
		r[i] = a[i] * b[i]
	}
	return r
}

func oracleAnd16(a, b [16]byte) [16]byte {
	var r [16]byte
	for i := range r {
		r[i] = a[i] & b[i]
	}
	return r
}

func oracleSum64(a [64]byte) byte {
	var s byte
	for _, v := range a {
		s += v
	}
	return s
}

func oracleDot4(a, b [4]float64) float64 {
	var s float64
	for i := range a {
		s += a[i] * b[i]
	}
	return s
}

func checkAdd4() {
	a := [4]float64{1, 2, 3, 4}
	b := [4]float64{5, 6, 7, 8}
	if got, want := a+b, oracleAdd4(a, b); got != want {
		panic(fmt.Sprintf("add4: got %v want %v", got, want))
	}
	if s := a.sum(); s != a[0]+a[1]+a[2]+a[3] {
		panic(fmt.Sprintf("sum4 mismatch: got %v want %v", s, a[0]+a[1]+a[2]+a[3]))
	}
	if a.dot(b) != oracleDot4(a, b) {
		panic("dot4 mismatch")
	}
}

func checkMul8() {
	var a, b [8]float32
	for i := range a {
		a[i] = float32(i + 1)
		b[i] = float32(2*i + 1)
	}
	if got, want := a*b, oracleMul8(a, b); got != want {
		panic(fmt.Sprintf("mul8: got %v want %v", got, want))
	}
}

func checkAnd16() {
	var a, b [16]byte
	for i := range a {
		a[i] = byte(i*17 + 3)
		b[i] = byte(i*11 + 5)
	}
	if (a & b) != oracleAnd16(a, b) {
		panic("and16 mismatch")
	}
	if (a | b) != oracleOr16(a, b) {
		panic("or16 mismatch")
	}
}

func oracleOr16(a, b [16]byte) [16]byte {
	var r [16]byte
	for i := range r {
		r[i] = a[i] | b[i]
	}
	return r
}

func check64() {
	var c [64]byte
	for i := range c {
		c[i] = byte(i + 1)
	}
	if c.sum() != oracleSum64(c) {
		panic("sum64 mismatch")
	}
	var x, y [8]float64
	for i := range x {
		x[i] = float64(i) + 0.5
		y[i] = float64(8 - i)
	}
	if got, want := x+y, oracleAdd8(x, y); got != want {
		panic(fmt.Sprintf("add8: got %v want %v", got, want))
	}
	var p, q [4]int64
	for i := range p {
		p[i] = int64(i*3 - 2)
		q[i] = int64(5 - i)
	}
	if (p + q) != oracleAdd4i(p, q) {
		panic("add4i mismatch")
	}
}

func oracleAdd8(a, b [8]float64) [8]float64 {
	var r [8]float64
	for i := range r {
		r[i] = a[i] + b[i]
	}
	return r
}

func oracleAdd4i(a, b [4]int64) [4]int64 {
	var r [4]int64
	for i := range r {
		r[i] = a[i] + b[i]
	}
	return r
}

func main() {
	checkSeam()
	checkAdd4()
	checkMul8()
	checkAnd16()
	check64()
	fmt.Println("simdcpu ok")
}
