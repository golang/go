// run

package jsonstringwrong

import (
	"encoding/json"
	"reflect"
	"strings"
	"testing"
)

type WrongJSON string

func (w *WrongJSON) UnmarshalJSON(v int) error {
	*w = "method"
	return nil
}

type WrongPointerHolder struct {
	V     *WrongJSON `json:"v,string"`
	After int64      `json:"after"`
}

type WrongPointerHolderMirror struct {
	V     *WrongJSON `json:"v,string"`
	After int64      `json:"after"`
	NoGen any        `json:"-"`
}

func TestStringMethodWrongSignaturePointerNull(t *testing.T) {
	for _, token := range []string{`"null"`, `"\u006eull"`, `"\"new\""`, `"bad"`} {
		t.Run(token, func(t *testing.T) {
			gotAlias, wantAlias := new(WrongJSON("seed")), new(WrongJSON("seed"))
			got := WrongPointerHolder{V: gotAlias}
			want := WrongPointerHolderMirror{V: wantAlias}
			doc := `{"v":` + token + `,"after":17}`
			gotErr := json.Unmarshal([]byte(doc), &got)
			wantErr := json.Unmarshal([]byte(doc), &want)
			if (gotErr == nil) != (wantErr == nil) {
				t.Fatalf("error = %v, encoding/json = %v", gotErr, wantErr)
			}
			if gotErr != nil && gotErr.Error() != strings.ReplaceAll(wantErr.Error(), "WrongPointerHolderMirror", "WrongPointerHolder") {
				t.Fatalf("error = %v, encoding/json = %v", gotErr, wantErr)
			}
			if !reflect.DeepEqual(got.V, want.V) || got.After != want.After {
				t.Fatalf("value = %+v, encoding/json = %+v", got, want)
			}
			if (got.V == gotAlias) != (want.V == wantAlias) || *gotAlias != *wantAlias {
				t.Fatalf("alias update = %v/%v, encoding/json = %v/%v", got.V == gotAlias, *gotAlias, want.V == wantAlias, *wantAlias)
			}
		})
	}
}

type WrongText string

func (w *WrongText) UnmarshalText(b []byte) bool {
	*w = "method"
	return true
}

type WrongHolder struct {
	V WrongJSON `json:"v,string"`
	W WrongText `json:"w,string"`
}

type WrongHolderMirror struct {
	V     WrongJSON `json:"v,string"`
	W     WrongText `json:"w,string"`
	NoGen any       `json:"-"`
}

func TestStringMethodWrongSignatureStaysScalar(t *testing.T) {
	docs := []string{
		`{"v":"hi","w":"yo"}`,
		`{"v":"\"hi\"","w":"\"yo\""}`,
		`{"v":null,"w":null}`,
		`{"v":7,"w":true}`,
	}
	for _, doc := range docs {
		var h WrongHolder
		var m WrongHolderMirror
		herr := json.Unmarshal([]byte(doc), &h)
		merr := json.Unmarshal([]byte(doc), &m)
		if (herr != nil) != (merr != nil) {
			t.Fatalf("error parity breaks for %s: static %v, oracle %v", doc, herr, merr)
		}
		if h.V != m.V || h.W != m.W {
			t.Fatalf("scalar behavior diverges for %s: static %+v, oracle %+v", doc, h, m)
		}
		if h.V == "method" || h.W == "method" {
			t.Fatalf("wrong-signature method ran for %s: %+v", doc, h)
		}
	}
}
