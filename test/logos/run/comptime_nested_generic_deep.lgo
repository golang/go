// run
package main

import (
	"comptime"
	"fmt"
	"os"
)

type Cfg struct {
	Port int
	DB   DBCfg
}

type DBCfg struct {
	Max int
}

func Load[T any](out T) T {
	const for _, f := range comptime.Fields[T]() {
		parse[f.Type](&out.[f])
	}
	return out
}

func parse[F any](dst *F) {
	const if comptime.IsStruct[F]() {
		const for _, g := range comptime.Fields[F]() {
			parse[g.Type](&dst.[g])
		}
	} else {
		const switch F {
		case int:
			*dst = 7
		}
	}
}

var failed bool

func check(name, got, want string) {
	if got != want {
		fmt.Println("FAIL", name, "got", got, "want", want)
		failed = true
		return
	}
	fmt.Println("ok", name)
}

func main() {
	check("nested-struct-recursion", fmt.Sprint(Load[Cfg](Cfg{})), "{7 {7}}")
	if failed {
		os.Exit(1)
	}
}
