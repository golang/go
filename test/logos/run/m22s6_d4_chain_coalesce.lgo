// run

package main

import "fmt"

// M22-S6 defect D4 (SPEC T-104.3, T-104.6): a `??` at the top of a chain
// lambda body lowers before the chain fragment re-parses as Go.

type P struct {
	N int64
	O string?
}

func main() {
	xs := []P{{N: 1}, {N: 2}}
	xs[1].O = "b"
	fmt.Println(xs.map(x => x.O ?? "none"))
}
